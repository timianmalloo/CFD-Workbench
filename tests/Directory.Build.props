<Project>
  <!-- Every test project is both a console harness (`<assembly> - -harness …`: the PASS/FAIL/SKIP lines) and an xunit v3 test
       assembly: tests/HarnessTests.cs runs the harness once per `dotnet test` and reports each line as one test. The entry
       point is the project's own Program.cs, which hands anything but `- -harness` to xunit, so xunit must not generate one. -->
  <PropertyGroup>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Compile Include="$(MSBuildThisFileDirectory)HarnessTests.cs" Link="HarnessTests.cs" />
  </ItemGroup>
</Project>
