<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike only (track GSPK). The assembly name reuses the Core test assembly's InternalsVisibleTo grant so the probe
       runs the as-built exact Rational, Bernstein.Spans, ProofBudget and the private admission proofs (by reflection)
       as its oracle. It is not in CFDWorkbench.slnx and ships nothing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CfdWorkbench.Core.Tests</AssemblyName>
    <RootNamespace>GspkProbe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/CfdWorkbench.Core/CfdWorkbench.Core.csproj" />
  </ItemGroup>
</Project>
