<Project Sdk="Microsoft.NET.Sdk">
  <!-- Probe only (M1.2d catalog Replace design, docs/design/m12d-catalog.md). The assembly name reuses the Core test assembly's InternalsVisibleTo grant so the probe
       calls the as-built SplineBasis, ChannelEvaluator, ConstrainedFit and FoilSource directly, and New foil's private
       construction and WingEstimates' area integral by reflection. It is not in CFDWorkbench.slnx and ships nothing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CfdWorkbench.Core.Tests</AssemblyName>
    <RootNamespace>ReplaceProbe</RootNamespace>
    <CoreProject Condition="'$(CoreProject)' == ''">../../../../src/CfdWorkbench.Core/CfdWorkbench.Core.csproj</CoreProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CoreProject)" />
  </ItemGroup>
</Project>
