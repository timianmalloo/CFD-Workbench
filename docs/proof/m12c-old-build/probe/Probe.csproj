<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the 4b9bc35 CLI and app controller on the fixtures. Build with -p:OldBuildRoot=<a worktree at 4b9bc35>. Not in the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OldBuildRoot Condition="'$(OldBuildRoot)' == ''">../../../..</OldBuildRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OldBuildRoot)/src/CfdWorkbench.Desktop/CfdWorkbench.Desktop.csproj" />
    <ProjectReference Include="$(OldBuildRoot)/src/CfdWorkbench.Cli/CfdWorkbench.Cli.csproj" />
  </ItemGroup>
</Project>
