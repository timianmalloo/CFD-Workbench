{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/session-start.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/session-start.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot",
        "timeoutSec": 10
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/session-start.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/session-start.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/reread-guard.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/reread-guard.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot",
        "timeoutSec": 10,
        "matcher": "^view$"
      },
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/mail-doorbell.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot --event preToolUse",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/mail-doorbell.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot --event preToolUse",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/heartbeat.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot --event postToolUse",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/heartbeat.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot --event postToolUse",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/reread-guard.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/reread-guard.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/mail-doorbell.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot --event agentStop",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/mail-doorbell.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot --event agentStop",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/heartbeat.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot --event agentStop",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/heartbeat.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot --event agentStop",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/owner-review-gate.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot --event agentStop",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/owner-review-gate.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot --event agentStop",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/mail-doorbell.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot --event subagentStop",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/mail-doorbell.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot --event subagentStop",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/heartbeat.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot --event subagentStop",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/heartbeat.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot --event subagentStop",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "h=docs/ai-forward-pack/hooks/owner-review-gate.py; [ -f \"$h\" ] || h=\"$(git rev-parse --show-toplevel)/$h\"; python3 \"$h\" --host copilot --event subagentStop",
        "powershell": "$h = 'docs/ai-forward-pack/hooks/owner-review-gate.py'; if (-not (Test-Path $h)) { $h = Join-Path (git rev-parse --show-toplevel) $h }; python $h --host copilot --event subagentStop",
        "timeoutSec": 10
      }
    ]
  }
}
