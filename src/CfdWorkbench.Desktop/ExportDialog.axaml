<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CfdWorkbench.Desktop.ExportDialog" Title="Export"
        Width="{StaticResource ExportDialogWidth}" SizeToContent="Height" MaxHeight="{StaticResource DialogMaxHeight}"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}">
  <Border Padding="{StaticResource DialogPadding}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="{StaticResource HairlineThickness}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource DialogSpacing}">
      <TextBlock x:Name="TitleText" Grid.Row="0" Classes="heading" Text="Export" />
      <ScrollViewer x:Name="BodyScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource DialogSpacing}">
          <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="8">
              <ListBox x:Name="FormatList" AutomationProperties.Name="Format">
                <ListBoxItem x:Name="DatFormatItem" IsSelected="True" />
                <ListBoxItem x:Name="StlFormatItem" />
                <ListBoxItem x:Name="ThreeMfFormatItem" />
              </ListBox>
              <Button x:Name="StepButton" Content="STEP" IsEnabled="False" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="StepWhy" TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <StackPanel x:Name="OptionsPanel" Grid.Column="1" Spacing="8">
              <StackPanel x:Name="StlOptions" Spacing="8" IsVisible="False">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="ScopeLegend" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <RadioButton x:Name="ScopeWhole" GroupName="scope" IsChecked="True" />
                      <RadioButton x:Name="ScopeHalf" GroupName="scope" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="UnitLegend" FontWeight="SemiBold" />
                    <TextBlock x:Name="UnitText" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                  <TextBlock x:Name="ToleranceLegend" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="ToleranceDraft" GroupName="tolerance" />
                    <RadioButton x:Name="TolerancePrint" GroupName="tolerance" IsChecked="True" />
                    <RadioButton x:Name="ToleranceFine" GroupName="tolerance" />
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ScopeHelp" IsVisible="False" TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <StackPanel x:Name="CadOptions" Spacing="8" IsVisible="False">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="CadScopeLegend" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <RadioButton x:Name="CadScopeWhole" GroupName="cad-scope" IsChecked="True" />
                      <RadioButton x:Name="CadScopeHalf" GroupName="cad-scope" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="CadUnitLegend" FontWeight="SemiBold" />
                    <TextBlock x:Name="CadUnitText" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="StepVariantPanel" Spacing="4" IsVisible="False">
                  <TextBlock x:Name="StepVariantLegend" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="StepVariantClosed" GroupName="step-variant" IsChecked="True" />
                    <RadioButton x:Name="StepVariantUntrimmed" GroupName="step-variant" />
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="CadScopeHelp" IsVisible="False" TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <StackPanel x:Name="DatOptions" Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="ShapeLegend" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <RadioButton x:Name="ShapeAtStation" GroupName="shape" IsChecked="True" />
                      <RadioButton x:Name="ShapeOwn" GroupName="shape" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="StationLegend" FontWeight="SemiBold" />
                    <ComboBox x:Name="StationBox" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <TextBlock x:Name="ShapeHelp" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="OrderLegend" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <RadioButton x:Name="OrderSelig" GroupName="order" IsChecked="True" />
                      <RadioButton x:Name="OrderLednicer" GroupName="order" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="PointsLegend" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <RadioButton x:Name="Points61" GroupName="points" Content="61" />
                      <RadioButton x:Name="Points101" GroupName="points" Content="101" IsChecked="True" />
                      <RadioButton x:Name="Points201" GroupName="points" Content="201" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Grid>
          <Border x:Name="SummaryBlock" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space3}">
            <StackPanel Spacing="8">
              <TextBlock x:Name="SummaryHeading" FontWeight="SemiBold" />
              <Grid x:Name="SummaryGrid" ColumnDefinitions="180,*" ColumnSpacing="8" />
              <TextBlock x:Name="LimitLine" TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <Border x:Name="PreviewBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
                <TextBlock x:Name="PreviewText" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource CaptionSize}"
                           AutomationProperties.Name="First lines of the file" />
              </Border>
            </StackPanel>
          </Border>
          <Border x:Name="BlockedBand" IsVisible="False" Padding="{StaticResource Space2}" BorderBrush="{DynamicResource DangerBrush}"
                  BorderThickness="{StaticResource HairlineThickness}">
            <TextBlock x:Name="BlockedText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Assertive" />
          </Border>
          <Border x:Name="LargeBand" IsVisible="False" Padding="{StaticResource Space2}" BorderBrush="{DynamicResource WarningBrush}"
                  BorderThickness="{StaticResource WarningBandBorder}">
            <TextBlock x:Name="LargeText" TextWrapping="Wrap" />
          </Border>
          <Border x:Name="ToleranceBand" IsVisible="False" Padding="{StaticResource Space2}" BorderBrush="{DynamicResource WarningBrush}"
                  BorderThickness="{StaticResource WarningBandBorder}">
            <TextBlock x:Name="ToleranceText" TextWrapping="Wrap" />
          </Border>
          <Border x:Name="ClosureBand" IsVisible="False" Padding="{StaticResource Space2}" BorderBrush="{DynamicResource DangerBrush}"
                  BorderThickness="{StaticResource HairlineThickness}">
            <StackPanel Spacing="4">
              <TextBlock x:Name="ClosureText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Assertive" />
              <TextBlock x:Name="ClosureDetails" TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Border>
          <Border x:Name="FindingBand" IsVisible="False" Padding="{StaticResource Space2}" BorderBrush="{DynamicResource WarningBrush}"
                  BorderThickness="{StaticResource WarningBandBorder}">
            <DockPanel>
              <Button x:Name="JumpButton" DockPanel.Dock="Right" />
              <TextBlock x:Name="FindingText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border x:Name="FailureBand" IsVisible="False" Padding="{StaticResource Space2}" BorderBrush="{DynamicResource DangerBrush}"
                  BorderThickness="{StaticResource HairlineThickness}">
            <StackPanel Spacing="8">
              <TextBlock x:Name="FailureText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Assertive" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AnotherPlaceButton" />
                <Button x:Name="TryAgainButton" />
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel x:Name="WritingBand" IsVisible="False" Spacing="4">
            <TextBlock x:Name="WritingText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="WritingProgress" IsIndeterminate="True" AutomationProperties.Name="Writing" />
          </StackPanel>
          <TextBlock x:Name="SafetyLine" TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StackGap2}">
        <TextBlock x:Name="NoAssistantNoteText" Grid.Column="0" Text="No assistant action here." TextWrapping="Wrap"
                   VerticalAlignment="Center" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
        <StackPanel x:Name="FooterButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="ExportButton" Classes="primary" IsDefault="True" />
          <Button x:Name="CancelButton" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
