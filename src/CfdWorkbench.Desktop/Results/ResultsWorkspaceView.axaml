<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:results="using:CfdWorkbench.Desktop.Results"
             x:Class="CfdWorkbench.Desktop.Results.ResultsWorkspaceView">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
    <!-- Header bar: Sample picker, ParaView handoff, Table twin toggle -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="{StaticResource PropRuleBottom}" Padding="{StaticResource Space2}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource StackGap2}">
          <ToggleButton x:Name="TableTwinToggle" Content="Linked table twin" IsChecked="True" />
          <Button x:Name="OpenParaViewButton" Content="Open in ParaView" MinHeight="{StaticResource ControlHeight}" IsEnabled="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource StackGap2}">
          <TextBlock Text="Results &amp; Candidate Ladder" Classes="heading" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
          <ComboBox x:Name="SamplePicker" MinWidth="{StaticResource ResultsSamplePickerWidth}" VerticalAlignment="Center" />
          <TextBlock x:Name="NoCrossTierNoteText" VerticalAlignment="Center" FontSize="{StaticResource CaptionSize}"
                     Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main scrollable two-column body -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="{StaticResource Space2}">
      <!-- Left column: Field canvas, 9-field ProvenanceStrip, Linked Table Twin, Replay, Difference flood -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Margin="{StaticResource RunPaneGap}">
        <StackPanel Spacing="{StaticResource StackGap2}">
          <!-- ParaView status banner -->
          <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space1}">
            <TextBlock x:Name="ParaViewStatusText" FontSize="{StaticResource CaptionSize}"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          </Border>

          <!-- Surface field canvas -->
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space1}">
            <results:ResultsFieldCanvas x:Name="FieldCanvas" MinHeight="{StaticResource ResultsFieldCanvasMinHeight}" />
          </Border>

          <!-- 9-field ProvenanceStrip -->
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource ProvenanceStripPadding}">
            <StackPanel Spacing="{StaticResource StackGap1}">
              <TextBlock Text="Provenance strip (9 required fields)" FontWeight="SemiBold"
                         FontSize="{DynamicResource PropTitleSize}" Foreground="{DynamicResource InkBrush}" />
              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="ProvVariableText" Classes="pnl-cell" Text="Not recorded" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ProvUnitText" Classes="pnl-cell" Text="Not recorded" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ProvRangeText" Classes="pnl-cell" Text="Not recorded" />
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="ProvMethodText" Classes="pnl-cell" Text="Not recorded" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProvSourceRunText" Classes="pnl-cell" Text="Not recorded" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ProvDepthBasisText" Classes="pnl-cell" Text="Not recorded" />
                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="ProvEvidenceLabelText" Classes="pnl-cell" Text="Not recorded" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProvColormapText" Classes="pnl-cell" Text="Not recorded" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ProvAssociationText" Classes="pnl-cell" Text="Not recorded" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Linked Table Twin -->
          <Border x:Name="TableTwinContainer" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
            <StackPanel Spacing="{StaticResource StackGap1}">
              <TextBlock x:Name="TableTwinHeadingText" Text="Linked table twin" FontWeight="SemiBold"
                         FontSize="{DynamicResource PropTitleSize}" Foreground="{DynamicResource InkBrush}" />
              <ListBox x:Name="TableTwinList" MaxHeight="{StaticResource RunListMaxHeight}" />
            </StackPanel>
          </Border>

          <!-- Replay controls -->
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
            <StackPanel Spacing="{StaticResource StackGap1}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="ReplayRangeLabelText" FontSize="{StaticResource CaptionSize}"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ReplayBannerText" Text="Parametric sweep — sequence over admitted samples"
                           FontWeight="SemiBold" FontSize="{DynamicResource PropTitleSize}" Foreground="{DynamicResource InkBrush}" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource StackGap1}">
                <Button x:Name="ReplayPlayButton" Content="Play" MinHeight="{StaticResource ControlHeight}" />
                <Button x:Name="ReplayHoldButton" Content="Hold" MinHeight="{StaticResource ControlHeight}" />
                <Button x:Name="ReplayStepBackButton" Content="Step back" MinHeight="{StaticResource ControlHeight}" />
                <Button x:Name="ReplayStepForwardButton" Content="Step forward" MinHeight="{StaticResource ControlHeight}" />
                <ToggleButton x:Name="ReplayLockRangeToggle" Content="Lock range" IsChecked="True" />
                <ComboBox x:Name="ReplayHoldAxisPicker" MinWidth="{StaticResource SweepInputMinWidth}" />
              </StackPanel>
              <Slider x:Name="ReplayScrubSlider" Minimum="0" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock x:Name="ReplayFrameStatusText" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <Border x:Name="ReplayFailureBanner" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
                      BorderBrush="{DynamicResource DangerBrush}" BorderThickness="{StaticResource PropRailThickness}"
                      Padding="{StaticResource Space1}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource StackGap2}">
                  <TextBlock x:Name="ReplayFailureText" TextWrapping="Wrap" VerticalAlignment="Center"
                             FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource DangerBrush}" />
                  <Button x:Name="ReplayRetrySampleButton" Content="Retry sample" MinHeight="{StaticResource CompactTargetSize}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Difference flood -->
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
            <StackPanel Spacing="{StaticResource StackGap1}">
              <TextBlock Text="Difference flood (zero-pinned vik)" FontWeight="SemiBold"
                         FontSize="{DynamicResource PropTitleSize}" Foreground="{DynamicResource InkBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource StackGap1}">
                <ComboBox x:Name="DiffBasePicker" MinWidth="{StaticResource SweepInputMinWidth}" />
                <ComboBox x:Name="DiffTargetPicker" MinWidth="{StaticResource SweepInputMinWidth}" />
                <Button x:Name="ComputeDiffButton" Content="Compute difference" MinHeight="{StaticResource ControlHeight}" />
              </StackPanel>
              <TextBlock x:Name="DiffStatusText" Classes="pnl-cell" TextWrapping="Wrap" />
              <TextBlock x:Name="DiffRangeText" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Right column: FieldEvidenceManifest layers, Candidate Ladder, offline AI-10 Ask -->
      <ScrollViewer Grid.Column="1" Width="{StaticResource ResultsInspectorWidth}"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource StackGap2}">
          <!-- Manifest-driven layer toggles -->
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
            <StackPanel Spacing="{StaticResource StackGap1}">
              <TextBlock Text="Field evidence layers" FontWeight="SemiBold"
                         FontSize="{DynamicResource PropTitleSize}" Foreground="{DynamicResource InkBrush}" />

              <ToggleButton x:Name="LayerSurfaceCpToggle" Content="Surface Cp" HorizontalAlignment="Stretch" IsChecked="True" />
              <TextBlock x:Name="LayerSurfaceCpBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerSurfaceCfToggle" Content="Surface Cf" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerSurfaceCfBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerSliceVelocityToggle" Content="Velocity slice" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerSliceVelocityBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerStreamlinesToggle" Content="3D streamlines" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerStreamlinesBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerTkeToggle" Content="Turbulent kinetic energy" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerTkeBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerForceVectorsToggle" Content="Force vectors" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerForceVectorsBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerSpanwiseLoadingToggle" Content="Spanwise loading" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerSpanwiseLoadingBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerVortexCoreToggle" Content="Vortex-core candidates" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerVortexCoreBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerSeparationToggle" Content="Separation" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerSeparationBasisText" Classes="pnl-note" />

              <ToggleButton x:Name="LayerPathlinesToggle" Content="Pathlines" HorizontalAlignment="Stretch" />
              <TextBlock x:Name="LayerPathlinesBasisText" Classes="pnl-note" />
            </StackPanel>
          </Border>

          <!-- Candidate Ladder -->
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
            <StackPanel Spacing="{StaticResource StackGap1}">
              <TextBlock Text="Candidate ladder (COMMIT-01)" FontWeight="SemiBold"
                         FontSize="{DynamicResource PropTitleSize}" Foreground="{DynamicResource InkBrush}" />
              <TextBlock x:Name="CandidateParetoSummaryText" Classes="pnl-note" />
              <TextBlock x:Name="CandidateEmptyReasonText" Classes="pnl-note" IsVisible="False" />
              <ListBox x:Name="CandidateList" MaxHeight="{StaticResource RunListMaxHeight}" />
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource StackGap1}">
                <Button x:Name="AcceptAsDraftButton" Classes="primary" Content="Accept as draft"
                        MinHeight="{StaticResource ControlHeight}" IsEnabled="False" />
                <Button x:Name="RebaseDraftButton" Content="Rebase"
                        MinHeight="{StaticResource ControlHeight}" IsEnabled="False" />
              </StackPanel>
              <TextBlock x:Name="CandidateDraftStatusText" Classes="pnl-note" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Offline & live BYOK AI-10 Ask about this result -->
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
            <StackPanel Spacing="{StaticResource StackGap1}">
              <TextBlock x:Name="AskResultHeadingText" Text="Ask about this result (offline)" FontWeight="SemiBold"
                         FontSize="{DynamicResource PropTitleSize}" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal">
                <Border x:Name="AskResultUsageChip" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="{StaticResource HairlineThickness}"
                        Padding="{StaticResource ChipPadding}" Margin="{StaticResource UnitGap}">
                  <TextBlock x:Name="AskResultUsageChipText" Classes="pnl-cell" Foreground="{DynamicResource MutedBrush}" Text="Used 0/50 today" />
                </Border>
                <Button x:Name="AskResultConfigureKeyButton" Content="Configure key" Margin="{StaticResource UnitGap}"
                        MinHeight="{StaticResource CompactTargetSize}" AutomationProperties.Name="Configure API key" />
              </WrapPanel>
              <TextBlock x:Name="AskResultStatusText" Classes="pnl-note" IsVisible="False" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="AskResultInput" Grid.Column="0" Watermark="Ask about separation or field evidence…" />
                <Button x:Name="AskResultButton" Grid.Column="1" Content="Ask" Margin="{StaticResource UnitGap}" />
              </Grid>
              <TextBlock x:Name="AskResultAnswerText" Classes="pnl-cell" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
