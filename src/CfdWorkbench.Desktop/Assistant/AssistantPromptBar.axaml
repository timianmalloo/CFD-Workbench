<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CfdWorkbench.Desktop.Assistant.AssistantPromptBar">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="{StaticResource HairlineThickness}"
          Padding="{StaticResource Space2}">
    <StackPanel Spacing="{StaticResource StackGap1}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource StackGap1}" VerticalAlignment="Center">
          <Border Background="{DynamicResource SurfaceSoftBrush}"
                  BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}"
                  Padding="{StaticResource ChipPadding}">
            <TextBlock x:Name="StatusBadgeText"
                       FontSize="{StaticResource CaptionSize}"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="No key" />
          </Border>
          <Button x:Name="ConfigureKeyButton"
                  Content="Configure key"
                  MinHeight="{StaticResource CompactTargetSize}"
                  AutomationProperties.Name="Configure API key" />
          <Button x:Name="OpenSettingsButton"
                  Content="Open Settings"
                  IsVisible="False"
                  MinHeight="{StaticResource CompactTargetSize}"
                  AutomationProperties.Name="Open assistant settings" />
        </StackPanel>
        <TextBlock x:Name="EntryTitleText"
                   FontWeight="SemiBold"
                   FontSize="{StaticResource PropTitleSize}"
                   Foreground="{DynamicResource InkBrush}"
                   VerticalAlignment="Center" />
      </DockPanel>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StackGap1}">
        <TextBox x:Name="PromptBox"
                 Grid.Column="0"
                 IsEnabled="False"
                 Watermark="Configure key in Settings to preview a checked proposal…"
                 AutomationProperties.Name="Assistant prompt" />
        <Button x:Name="SubmitButton"
                Grid.Column="1"
                Content="Preview"
                IsEnabled="False"
                MinHeight="{StaticResource ControlHeight}"
                AutomationProperties.Name="Preview assistant proposal" />
      </Grid>

      <TextBlock x:Name="StatusDetailText"
                 IsVisible="False"
                 FontSize="{StaticResource CaptionSize}"
                 Foreground="{DynamicResource MutedBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
