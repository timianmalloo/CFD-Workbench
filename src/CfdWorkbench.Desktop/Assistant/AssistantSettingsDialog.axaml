<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assistant="using:CfdWorkbench.Desktop.Assistant"
        x:Class="CfdWorkbench.Desktop.Assistant.AssistantSettingsDialog"
        Title="Assistant settings (BYOK)"
        Width="{StaticResource SettingsDialogWidth}"
        SizeToContent="Height"
        MaxHeight="{StaticResource DialogMaxHeight}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource InkBrush}">
  <Border Padding="{StaticResource DialogPadding}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="{StaticResource HairlineThickness}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource DialogSpacing}">
      <TextBlock x:Name="TitleText" Grid.Row="0" Classes="heading" Text="Assistant settings (BYOK)" />

      <ScrollViewer x:Name="BodyScrollViewer"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource DialogSpacing}">
          <!-- Section 1: API key (OS credential store) -->
          <Border Background="{DynamicResource CanvasBrush}"
                  BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}"
                  CornerRadius="{StaticResource RoundedSm}"
                  Padding="{StaticResource Space3}">
            <StackPanel Spacing="{StaticResource StackGap2}">
              <TextBlock x:Name="CredentialSectionHeadingText"
                         Text="API key (OS credential store)"
                         FontWeight="SemiBold"
                         FontSize="{StaticResource PropTitleSize}"
                         Foreground="{DynamicResource InkBrush}" />
              <TextBlock x:Name="KeyStatusText"
                         TextWrapping="Wrap"
                         FontSize="{StaticResource CaptionSize}"
                         Foreground="{DynamicResource MutedBrush}" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource StackGap2}">
                <TextBox x:Name="ApiKeyBox"
                         Grid.Column="0"
                         PasswordChar="•"
                         Watermark="Paste API key (stored in OS credential store only)"
                         AutomationProperties.Name="API key" />
                <Button x:Name="SaveKeyButton"
                        Grid.Column="1"
                        Classes="primary"
                        Content="Save key"
                        MinHeight="{StaticResource ControlHeight}"
                        AutomationProperties.Name="Save API key" />
                <Button x:Name="RemoveKeyButton"
                        Grid.Column="2"
                        Content="Remove key"
                        MinHeight="{StaticResource ControlHeight}"
                        AutomationProperties.Name="Remove API key" />
              </Grid>
              <TextBlock x:Name="KeyFeedbackText"
                         IsVisible="False"
                         TextWrapping="Wrap"
                         FontSize="{StaticResource CaptionSize}"
                         Foreground="{DynamicResource InkBrush}"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>

          <!-- Section 2: Provider & endpoint -->
          <Border Background="{DynamicResource CanvasBrush}"
                  BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}"
                  CornerRadius="{StaticResource RoundedSm}"
                  Padding="{StaticResource Space3}">
            <StackPanel Spacing="{StaticResource StackGap2}">
              <TextBlock x:Name="ProviderSectionHeadingText"
                         Text="Provider &amp; endpoint"
                         FontWeight="SemiBold"
                         FontSize="{StaticResource PropTitleSize}"
                         Foreground="{DynamicResource InkBrush}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource StackGap2}" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource StackGap2}">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <ComboBox x:Name="ProviderPicker"
                          Grid.Row="0"
                          Grid.Column="1"
                          MinWidth="{StaticResource AssistantProviderWidth}"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Assistant provider" />

                <TextBlock x:Name="EndpointUrlLabelText"
                           Grid.Row="1"
                           Grid.Column="0"
                           Text="Endpoint URL"
                           VerticalAlignment="Top"
                           Margin="{StaticResource Space1}"
                           Foreground="{DynamicResource MutedBrush}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource StackGap1}">
                  <TextBox x:Name="EndpointUrlBox"
                           AutomationProperties.Name="Endpoint URL" />
                  <TextBlock x:Name="EndpointHelperText"
                             Text="Single HTTPS endpoint; HTTP allowed for exact localhost / 127.0.0.1 / ::1 only."
                             TextWrapping="Wrap"
                             FontSize="{StaticResource CaptionSize}"
                             Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <TextBlock x:Name="ModelIdLabelText"
                           Grid.Row="2"
                           Grid.Column="0"
                           Text="Model identifier"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="ModelIdBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         AutomationProperties.Name="Model identifier" />
              </Grid>
              <TextBlock x:Name="EndpointErrorText"
                         IsVisible="False"
                         TextWrapping="Wrap"
                         FontSize="{StaticResource CaptionSize}"
                         Foreground="{DynamicResource DangerBrush}"
                         AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </Border>

          <!-- Section 3: Caps & timeout -->
          <Border Background="{DynamicResource CanvasBrush}"
                  BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}"
                  CornerRadius="{StaticResource RoundedSm}"
                  Padding="{StaticResource Space3}">
            <StackPanel Spacing="{StaticResource StackGap2}">
              <TextBlock x:Name="CapsSectionHeadingText"
                         Text="Caps &amp; timeout"
                         FontWeight="SemiBold"
                         FontSize="{StaticResource PropTitleSize}"
                         Foreground="{DynamicResource InkBrush}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StackGap2}" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource StackGap1}">
                <TextBlock x:Name="PerRequestCapLabelText" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                <TextBox x:Name="PerRequestMaxTokensBox" Grid.Row="0" Grid.Column="1" Width="{StaticResource AssistantCapFieldWidth}" AutomationProperties.Name="Max output tokens per request" />

                <TextBlock x:Name="DailyCapLabelText" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                <TextBox x:Name="DailyCapBox" Grid.Row="1" Grid.Column="1" Width="{StaticResource AssistantCapFieldWidth}" AutomationProperties.Name="Daily UTC request cap" />

                <TextBlock x:Name="TimeoutLabelText" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                <TextBox x:Name="TimeoutSecondsBox" Grid.Row="2" Grid.Column="1" Width="{StaticResource AssistantCapFieldWidth}" AutomationProperties.Name="Request timeout in seconds" />
              </Grid>
              <TextBlock x:Name="DailyUsageText"
                         Classes="pnl-cell"
                         Foreground="{DynamicResource MutedBrush}" />
              <TextBlock x:Name="SettingsFeedbackText"
                         IsVisible="False"
                         TextWrapping="Wrap"
                         FontSize="{StaticResource CaptionSize}"
                         Foreground="{DynamicResource InkBrush}" />
            </StackPanel>
          </Border>

          <!-- Section 4: Model evaluation (A8.6, AI-06) -->
          <Border Background="{DynamicResource CanvasBrush}"
                  BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}"
                  CornerRadius="{StaticResource RoundedSm}"
                  Padding="{StaticResource Space3}">
            <StackPanel Spacing="{StaticResource StackGap2}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource StackGap1}">
                  <Button x:Name="RunEvalButton"
                          Content="Run 9-item evaluation"
                          MinHeight="{StaticResource ControlHeight}"
                          AutomationProperties.Name="Run 9-item model evaluation" />
                  <Button x:Name="CancelEvalButton"
                          Content="Cancel"
                          IsVisible="False"
                          MinHeight="{StaticResource ControlHeight}"
                          AutomationProperties.Name="Cancel model evaluation" />
                </StackPanel>
                <TextBlock x:Name="EvalSectionHeadingText"
                           Text="Model evaluation (9 active items; physical-fidelity reserved in v1)"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource PropTitleSize}"
                           Foreground="{DynamicResource InkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </DockPanel>
              <Border x:Name="EvalBusyBanner"
                      IsVisible="False"
                      Background="{DynamicResource SurfaceSoftBrush}"
                      BorderBrush="{DynamicResource PrimaryBrush}"
                      BorderThickness="{StaticResource PropRailThickness}"
                      Padding="{StaticResource Space2}">
                <TextBlock x:Name="EvalBusyStatusText"
                           Text="Running evaluation…"
                           FontSize="{StaticResource CaptionSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
              </Border>
              <Border x:Name="EvalStatusBanner"
                      Classes="eval-banner"
                      Background="{DynamicResource SurfaceSoftBrush}"
                      BorderThickness="{StaticResource PropRailThickness}"
                      Padding="{StaticResource Space2}">
                <StackPanel Spacing="{StaticResource StackGap1}">
                  <TextBlock x:Name="EvalStatusBadgeText"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource InkBrush}" />
                  <TextBlock x:Name="EvalStatusDetailText"
                             FontSize="{StaticResource CaptionSize}"
                             Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="{StaticResource HairlineThickness}"
                      Padding="{StaticResource Space2}">
                <ScrollViewer MaxHeight="{StaticResource AssistantListMaxHeight}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="EvalItemsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="assistant:EvalRowItem">
                        <Border BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="{StaticResource PropRuleBottom}"
                                Padding="{StaticResource Space1}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource StackGap2}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ItemId}"
                                       Classes="pnl-cell"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="{StaticResource ActivityRailBadgeGap}">
                              <TextBlock Text="{Binding Title}"
                                         FontSize="{StaticResource CaptionSize}"
                                         Foreground="{DynamicResource InkBrush}"
                                         TextWrapping="Wrap" />
                              <TextBlock Text="{Binding ScoreText}"
                                         Classes="pnl-cell"
                                         FontFamily="{StaticResource MonoFontFamily}"
                                         Foreground="{DynamicResource MutedBrush}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding StatusText}"
                                       Classes="pnl-cell"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource InkBrush}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>

          <!-- Section 5: Local assistant audit log -->
          <Border Background="{DynamicResource CanvasBrush}"
                  BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}"
                  CornerRadius="{StaticResource RoundedSm}"
                  Padding="{StaticResource Space3}">
            <StackPanel Spacing="{StaticResource StackGap2}">
              <TextBlock x:Name="AuditSectionHeadingText"
                         Text="Local assistant audit log"
                         FontWeight="SemiBold"
                         FontSize="{StaticResource PropTitleSize}"
                         Foreground="{DynamicResource InkBrush}" />
              <TextBlock x:Name="AuditEmptyText"
                         FontSize="{StaticResource CaptionSize}"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="No assistant requests recorded yet." />
              <ScrollViewer MaxHeight="{StaticResource AssistantListMaxHeight}"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AuditEntriesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="assistant:AuditRowItem">
                      <Border BorderBrush="{DynamicResource LineBrush}"
                              BorderThickness="{StaticResource PropRuleBottom}"
                              Padding="{StaticResource Space1}">
                        <StackPanel Spacing="{StaticResource ActivityRailBadgeGap}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StackGap2}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding HeaderLine}"
                                       FontSize="{StaticResource CaptionSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding OutcomeText}"
                                       Classes="pnl-cell"
                                       Foreground="{DynamicResource MutedBrush}" />
                          </Grid>
                          <TextBlock Text="{Binding MetricsLine}"
                                     Classes="pnl-cell"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     Foreground="{DynamicResource MutedBrush}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel x:Name="FooterButtons"
                  Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="{StaticResource StackGap2}"
                  HorizontalAlignment="Right">
        <Button x:Name="SaveSettingsButton"
                Classes="primary"
                Content="Save settings"
                MinHeight="{StaticResource ControlHeight}"
                IsDefault="True"
                AutomationProperties.Name="Save assistant settings" />
        <Button x:Name="CloseButton"
                Content="Close"
                MinHeight="{StaticResource ControlHeight}"
                IsCancel="True"
                AutomationProperties.Name="Close assistant settings" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
