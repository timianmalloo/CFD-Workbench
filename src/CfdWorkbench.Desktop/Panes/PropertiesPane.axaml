<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CfdWorkbench.Desktop.Panes.PropertiesPane" AutomationProperties.Name="Properties">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource Space4}" Spacing="12">
      <!-- Error State for PaneBind_Throws -->
      <Border x:Name="ErrorPanel" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
              BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
              Padding="{StaticResource Space3}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="ErrorText" Text="Properties couldn't be shown." Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
          <Button x:Name="TryAgainButton" Content="Try again" />
        </StackPanel>
      </Border>

      <!-- Empty State -->
      <StackPanel x:Name="EmptyPanel" Spacing="8" IsVisible="True">
        <TextBlock Classes="heading" Text="No foil open" />
        <TextBlock Classes="caption" Text="Open or start a foil. Whatever you select in it shows its properties here." TextWrapping="Wrap" />
      </StackPanel>

      <!-- Content Panel -->
      <StackPanel x:Name="ContentPanel" Spacing="12" IsVisible="False">
        <TextBlock x:Name="SelectionHeading" Classes="heading" Text="Selected Properties" />

        <!-- Blocks Container -->
        <StackPanel x:Name="BlocksPanel" Spacing="12" />

        <StackPanel x:Name="RecoveryPanel" Spacing="8" IsVisible="False">
          <TextBlock x:Name="RecoveryBanner" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="RecoveryApplyButton" Content="Apply" />
            <Button x:Name="RecoveryDiscardButton" Content="Discard" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="PointBlock" Spacing="8" IsVisible="False">
          <TextBlock x:Name="PointHeading" Classes="heading" TextWrapping="Wrap" />
          <TextBlock x:Name="PointHelper" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock x:Name="MixedBanner" TextWrapping="Wrap" IsVisible="False" />
          <TextBlock x:Name="TypeReadOnly" IsVisible="False" />
          <ComboBox x:Name="TypeControl" />
          <TextBlock x:Name="ConstraintText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Span" VerticalAlignment="Center" />
            <TextBox x:Name="PointSpanInput" />
            <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Aft" VerticalAlignment="Center" />
            <TextBox x:Name="PointAftInput" />
            <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <TextBlock x:Name="PointErrorText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" IsVisible="False" />
          <StackPanel x:Name="TangentGroup" Orientation="Horizontal" Spacing="8" IsVisible="False">
            <Button x:Name="TangentSmoothButton" Content="Smooth" />
            <Button x:Name="TangentSymmetricButton" Content="Symmetric" />
            <Button x:Name="TangentCornerButton" Content="Corner" />
          </StackPanel>
          <StackPanel x:Name="HandleGroup" Spacing="8" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Angle" VerticalAlignment="Center" />
              <TextBox x:Name="HandleAngleInput" />
              <TextBlock Text="deg" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Length" VerticalAlignment="Center" />
              <TextBox x:Name="HandleLengthInput" />
              <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Wing Block (Always Last when foil is open) -->
        <Border x:Name="WingBlock" Background="{DynamicResource SurfaceSoftBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                Padding="{StaticResource Space3}">
          <StackPanel Spacing="8">
            <TextBlock x:Name="WingHeading" Classes="heading" Text="Wing" />
            <TextBlock Text="Span" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" x:Name="SpanInput" AutomationProperties.Name="Span in millimetres" />
              <TextBlock Grid.Column="1" x:Name="SpanUnit" Text="mm" VerticalAlignment="Center" Margin="{StaticResource Space2}" />
            </Grid>
            <!-- Span error alert -->
            <Border x:Name="SpanErrorPanel" IsVisible="False" AutomationProperties.LiveSetting="Assertive" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    Padding="{StaticResource Space2}">
              <TextBlock x:Name="SpanErrorText" Foreground="{DynamicResource DangerBrush}" Classes="caption" TextWrapping="Wrap" />
            </Border>

            <!-- Readouts for root and tip chord -->
            <TextBlock x:Name="RootChordLabel" Classes="caption" Text="Root chord" />
            <TextBox x:Name="RootChordInput" />
            <TextBlock x:Name="RootChordText" Text="—" IsVisible="False" />
            <TextBlock x:Name="TipChordLabel" Classes="caption" Text="Tip chord" />
            <TextBox x:Name="TipChordInput" />
            <TextBlock x:Name="TipClosedText" TextWrapping="Wrap" IsVisible="False" />
            <TextBlock x:Name="TipChordText" Text="—" IsVisible="False" />
            <TextBlock x:Name="ChordWarningText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" IsVisible="False" />
            <TextBlock Text="Mean chord" />
            <TextBlock x:Name="MeanChordText" Text="≈ —" />
            <TextBlock Text="MAC" />
            <TextBlock x:Name="MacText" Text="≈ —" />
            <TextBlock Text="Max t/c" />
            <TextBlock x:Name="MaxTcText" Text="≈ —" />
            <TextBlock Text="Aspect ratio" />
            <TextBlock x:Name="AspectText" Text="≈ —" />
            <TextBlock Text="Area" />
            <TextBlock x:Name="AreaEstimateText" Text="≈ —" />
            <TextBlock x:Name="WingReasonText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" IsVisible="False" />
            <Button x:Name="HowMeasuredButton" Content="How these are measured" />
            <TextBlock x:Name="HowMeasuredBody" TextWrapping="Wrap" IsVisible="False"
                       Text="Mean chord, MAC, max t/c, aspect ratio, and area follow the planform. MAC is the mean aerodynamic chord." />

            <!-- Wing estimates -->
            <TextBlock Classes="caption" Text="Estimates" FontWeight="SemiBold" Margin="{StaticResource Space2}" />
            <TextBlock x:Name="EstimatesAreaText" Classes="caption" Text="Area: —" />
            <TextBlock x:Name="EstimatesAspectRatioText" Classes="caption" Text="Aspect ratio: —" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
