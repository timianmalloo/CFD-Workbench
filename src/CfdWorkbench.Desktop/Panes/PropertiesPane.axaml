<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CfdWorkbench.Desktop.Panes.PropertiesPane" AutomationProperties.Name="Properties"
             FontFamily="{StaticResource PropFontFamily}">
  <!-- The property sheet in structure B (docs/reviews/ui-property-grid-cells.md §5). PropertiesView.Build supplies the rows;
       this markup holds only the frame and the persistent editors, which the pane places into rows so focus survives a
       re-render (UI-C). -->
  <Panel>
    <StackPanel x:Name="FieldPool" IsVisible="False">
      <TextBox x:Name="SpanInput" Classes="prop-b" />
      <TextBox x:Name="RootChordInput" Classes="prop-b" />
      <TextBox x:Name="TipChordInput" Classes="prop-b" />
      <TextBox x:Name="PointSpanInput" Classes="prop-b" />
      <TextBox x:Name="PointAftInput" Classes="prop-b" />
      <TextBox x:Name="HandleAngleInput" Classes="prop-b" />
      <TextBox x:Name="HandleLengthInput" Classes="prop-b" />
      <ComboBox x:Name="TypeControl" Classes="prop-b" />
      <ComboBox x:Name="KindControl" Classes="prop-b" />
      <Border x:Name="SpanErrorPanel">
        <TextBlock x:Name="SpanErrorText" Classes="prop-message" />
      </Border>
    </StackPanel>

    <DockPanel>
      <Border x:Name="ErrorPanel" DockPanel.Dock="Top" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
              BorderBrush="{DynamicResource DangerBrush}" BorderThickness="{StaticResource HairlineThickness}"
              Padding="{StaticResource Space3}" Margin="{StaticResource Space4}">
        <StackPanel Spacing="{StaticResource StackGap2}">
          <TextBlock x:Name="ErrorText" Text="Properties couldn't be shown." Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
          <Button x:Name="TryAgainButton" Content="Try again" />
        </StackPanel>
      </Border>

      <StackPanel x:Name="EmptyPanel" DockPanel.Dock="Top" Spacing="{StaticResource StackGap2}" Margin="{StaticResource Space4}">
        <TextBlock Classes="heading" Text="No foil open" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="Open or start a foil. Whatever you select in it shows its properties here." TextWrapping="Wrap" />
      </StackPanel>

      <Grid x:Name="ContentPanel" RowDefinitions="*,Auto" IsVisible="False">
        <ScrollViewer x:Name="SelectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SelectionPanel">
            <Border x:Name="IdentityBlock" BorderBrush="{DynamicResource LineBrush}" BorderThickness="{StaticResource PropRuleBottom}">
            <Grid x:Name="IdentityPanel" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="{StaticResource PropIdentityPadding}">
              <Path x:Name="IdentityGlyphPath" Width="{StaticResource PropGlyphSize}" Height="{StaticResource PropGlyphSize}"
                    Stretch="Uniform" Stroke="{DynamicResource InkBrush}" StrokeThickness="{StaticResource GlyphStroke}"
                    VerticalAlignment="Center" />
              <TextBlock x:Name="IdentityTitle" Grid.Column="1" Classes="prop-title" TextWrapping="Wrap" VerticalAlignment="Center"
                         Margin="{StaticResource PropTitleGap}" />
              <HyperlinkButton x:Name="IdentityCrumbLink" Grid.Row="1" Grid.Column="1" Classes="prop-crumb" IsVisible="False"
                               Margin="{StaticResource PropTitleGap}" />
              <TextBlock x:Name="IdentityCrumb" Grid.Row="1" Grid.Column="1" Classes="prop-crumb" TextWrapping="Wrap" IsVisible="False"
                         Margin="{StaticResource PropTitleGap}" />
            </Grid>
            </Border>

            <Border x:Name="AlertBanner" IsVisible="False" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="{StaticResource PropRailThickness}" Padding="{StaticResource PropIdentityPadding}"
                    Background="{DynamicResource SurfaceSoftBrush}" AutomationProperties.LiveSetting="Assertive">
              <TextBlock x:Name="AlertBannerText" Classes="prop-message" />
            </Border>

            <Border x:Name="RecoveryPanel" IsVisible="False" BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="{StaticResource PropRailThickness}" Padding="{StaticResource PropIdentityPadding}"
                    Background="{DynamicResource SurfaceSoftBrush}" AutomationProperties.LiveSetting="Assertive">
              <StackPanel Spacing="{StaticResource StackGap2}">
                <TextBlock x:Name="RecoveryBanner" Classes="prop-message" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource StackGap2}">
                  <Button x:Name="RecoveryApplyButton" Content="Apply" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="{StaticResource HairlineThickness}" />
                  <Button x:Name="RecoveryDiscardButton" Content="Discard" Foreground="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="{StaticResource HairlineThickness}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel x:Name="BlocksPanel" />
          </StackPanel>
        </ScrollViewer>

        <!-- DR-UID-5: the Wing is pinned at the foot and always fully visible; the selection above it scrolls. It follows the
             selection in the tree so Tab reaches the selection's values first, as they read top to bottom (NS-1). -->
        <Border x:Name="WingBlock" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource ControlLineBrush}" BorderThickness="{StaticResource HairlineTop}">
          <ScrollViewer x:Name="WingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="prop-group-rule" BorderBrush="{DynamicResource LineBrush}" BorderThickness="{StaticResource PropRuleBottom}">
              <StackPanel x:Name="WingPanel">
                <!-- The Wing never collapses (UI-36), so its header carries no chevron (DR-CELL-2, change 1). -->
                <Grid x:Name="WingHeader" ColumnDefinitions="*,Auto" MinHeight="{DynamicResource PropHeadHeight}"
                      Margin="{StaticResource PropHeadPadding}">
                  <TextBlock x:Name="WingHeading" Classes="prop-group-title" Text="Wing" />
                  <Border x:Name="WingChip" Grid.Column="1" Classes="prop-chip" IsVisible="False">
                    <TextBlock x:Name="WingChipText" />
                  </Border>
                </Grid>
                <StackPanel x:Name="WingDimensions" />
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="{StaticResource PropRuleTop}" Margin="{StaticResource PropWingRuleMargin}" />
                <ToggleButton x:Name="HowMeasuredButton" Classes="prop-link">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource PropChevronGap}">
                    <Path x:Name="HowMeasuredChevron" Classes="prop-disclosure" AutomationProperties.AccessibilityView="Raw" Data="M0,0 L3,2.5 L0,5 Z" />
                    <TextBlock Text="Estimates · definitions" />
                  </StackPanel>
                </ToggleButton>
                <TextBlock x:Name="HowMeasuredBody" Classes="prop-note" IsVisible="False" Padding="{StaticResource PropNotePadding}"
                           Text="Span b: projected, tip to tip. Root and tip chord: at the centre line and the outermost station. Mean chord (geometric): S / b. MAC: the mean aerodynamic chord, (2/S)∫c(y)² dy over the half span, not the same as S / b. Max t/c: the largest thickness over chord at any station. AR: b²/S, dimensionless. Area: the projected planform area S, both halves." />
                <StackPanel x:Name="WingEstimates" />
                <StackPanel x:Name="WingNotes" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Border>
      </Grid>
    </DockPanel>
  </Panel>
</UserControl>
