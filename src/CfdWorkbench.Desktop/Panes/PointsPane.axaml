<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CfdWorkbench.Desktop.Panes.PointsPane" AutomationProperties.Name="Points"
             FontFamily="{StaticResource PropFontFamily}">
  <!-- The Points pane (design §11.4, OD-3 B): the control net in structure B's row look. PointsView.Build supplies the
       rows; the code-behind draws them. Rows are 24 px with tabular figures; a selected row and its partner carry a 2 px
       accent rail (Ruling 60). -->
  <UserControl.Styles>
    <Style Selector="TextBlock.pts-heading"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
    <Style Selector="TextBlock.pts-note"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.pts-col"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="TextBlock.pts-cell"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>
    <Style Selector="TextBlock.pts-cell.num"><Setter Property="TextAlignment" Value="Right" /></Style>
    <Style Selector="TextBlock.pts-cell.ro"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <!-- A narrow pane trims a type name with an ellipsis rather than cutting it to "Ha"; Kind keeps the mockup's 4 px gap
         after the right-aligned y. -->
    <Style Selector="TextBlock.pts-cell.type"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style Selector="TextBlock.pts-cell.kind, TextBlock.pts-col.kind"><Setter Property="Margin" Value="{StaticResource PointsKindGap}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style Selector="Border.pts-row"><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="BorderThickness" Value="{StaticResource PropRailThickness}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="{StaticResource PointsRowPadding}" /></Style>
    <Style Selector="Border.pts-row.on"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /></Style>
    <Style Selector="Border.pts-row.pair"><Setter Property="BorderBrush" Value="{DynamicResource StationBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /></Style>
    <Style Selector="Border.pts-row.error"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>
    <Style Selector="Button.pts-point"><Setter Property="Padding" Value="{StaticResource NoInset}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="{StaticResource NoInset}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>
    <!-- The global prop-b box is the Properties 62 px value column; here the box is its 50 px grid column. -->
    <Style Selector="TextBox.prop-b"><Setter Property="Padding" Value="{StaticResource PointsEditPadding}" /><Setter Property="MinWidth" Value="0" /><Setter Property="Width" Value="NaN" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="TextBlock.pts-error"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Button.pts-group"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="{StaticResource NoInset}" /><Setter Property="Padding" Value="{StaticResource PropHeadPadding}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  </UserControl.Styles>
  <DockPanel>
    <StackPanel x:Name="PointsEmpty" DockPanel.Dock="Top" Spacing="{StaticResource StackGap2}" Margin="{StaticResource Space4}" IsVisible="False">
      <TextBlock x:Name="PointsEmptyTitle" Classes="heading" TextWrapping="Wrap" />
      <TextBlock x:Name="PointsEmptyBody" Classes="caption" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel x:Name="PointsHead" DockPanel.Dock="Top" Margin="{StaticResource PropIdentityPadding}" Spacing="{StaticResource StackGap2}">
      <TextBlock x:Name="PointsHeading" Classes="pts-heading" />
      <TextBlock x:Name="PointsNote" Classes="pts-note" />
      <Grid x:Name="PointsColumns" />
    </StackPanel>
    <ScrollViewer x:Name="PointsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="PointsGroups" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
