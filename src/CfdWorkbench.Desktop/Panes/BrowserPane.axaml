<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CfdWorkbench.Desktop.Panes.BrowserPane" AutomationProperties.Name="Browser">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource Space4}" Spacing="12">
      <!-- Error State for PaneBind_Throws -->
      <Border x:Name="ErrorPanel" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
              BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
              Padding="{StaticResource Space3}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="ErrorText" Text="Browser couldn't be shown." Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
          <Button x:Name="TryAgainButton" Content="Try again" />
        </StackPanel>
      </Border>

      <!-- Empty State -->
      <StackPanel x:Name="EmptyPanel" Spacing="8" IsVisible="True">
        <TextBlock Classes="heading" Text="No foil open" />
      </StackPanel>

      <!-- Content Panel -->
      <StackPanel x:Name="ContentPanel" Spacing="8" IsVisible="False">
        <TextBlock x:Name="LeadingEdgeHeader" Classes="caption" Text="Leading edge" />
        <ListBox x:Name="LeadingEdgeList" />
        <TextBlock x:Name="TrailingEdgeHeader" Classes="caption" Text="Trailing edge" />
        <ListBox x:Name="TrailingEdgeList" />
        <TextBlock Classes="caption" Text="Accepted stations · normalized span η" />
        <ListBox x:Name="StationList" MaxHeight="{StaticResource NavigatorListHeight}"
                 AutomationProperties.Name="Accepted station assignments and profile identities" />
        <!-- M1.2b2 §11.4: the channel groups, the equivalent path to close points on the elevations (2.5.8). -->
        <TextBlock x:Name="DihedralHeader" Classes="caption" Text="Dihedral" />
        <ListBox x:Name="DihedralList" AutomationProperties.Name="Dihedral points" />
        <TextBlock x:Name="TwistHeader" Classes="caption" Text="Twist" />
        <ListBox x:Name="TwistList" AutomationProperties.Name="Twist points" />
        <TextBlock x:Name="ThicknessHeader" Classes="caption" Text="Thickness" />
        <ListBox x:Name="ThicknessList" AutomationProperties.Name="Thickness points" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
