<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CfdWorkbench.Desktop"
             xmlns:panes="using:CfdWorkbench.Desktop.Panes"
             xmlns:analysis="using:CfdWorkbench.Desktop.Analysis"
             x:Class="CfdWorkbench.Desktop.ModelArea">
  <UserControl.Resources>
    <!-- The Rebuild popover's place: the toast inset (12) on three sides; 52 at the bottom clears the navbar.
         simplify: a local token until the design system names it (ceiling: one popover; promote to Styles.axaml and
         DESIGN.md when a second viewport popover needs it). -->
    <Thickness x:Key="RebuildPopoverInset">12,12,12,52</Thickness>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Overlay text sits on a viewport-soft plate, never on the surface; the view-label plates are styled in Styles.axaml. -->
    <Style Selector="TextBlock.viewOverlay">
      <Setter Property="Foreground" Value="{DynamicResource ViewportInkBrush}" />
      <Setter Property="Background" Value="{DynamicResource PlanSoftBrush}" />
      <Setter Property="Padding" Value="{StaticResource Space2}" />
    </Style>
    <Style Selector="Border.viewError">
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{StaticResource Space2}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- DR-VIEW-1: each view is framed in a 1 px line; the 4 px gutter between frames shows the canvas colour behind the grid. -->
    <Style Selector="Border.viewFrame">
      <Setter Property="Background" Value="{DynamicResource ViewportBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" />
    </Style>
    <Style Selector="ToggleButton.navbar">
      <Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" />
      <Setter Property="Padding" Value="{StaticResource NavbarButtonPadding}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderThickness" Value="{StaticResource NoInset}" />
    </Style>
    <Style Selector="ToggleButton.navbar:checked">
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.navbar:checked /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.navbar:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.navbar:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0">
    <!-- Alert Band -->
    <Border Grid.Row="0" x:Name="AlertBand" IsVisible="False" AutomationProperties.LiveSetting="Assertive" Background="{DynamicResource SurfaceSoftBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="{StaticResource Space2}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="AlertBandText" Text="" VerticalAlignment="Center" />
        <Button x:Name="BandLocateButton" Content="Locate…" IsVisible="False" />
        <Button x:Name="BandTryAgainButton" Content="Try again" IsVisible="False" />
        <Button x:Name="BandOpenAnotherButton" Content="Open another file…" IsVisible="False" />
        <Button x:Name="BandRemoveRecentButton" Content="Remove from Recent" IsVisible="False" />
        <Button x:Name="AcceptIdsButton" Content="Accept candidate IDs" IsVisible="False"
                AutomationProperties.Name="Accept explicit ID insertion after comparing source" />
        <Button x:Name="ResumeRecoveryButton" Content="Resume draft" IsVisible="False"
                AutomationProperties.Name="Resume separate recovery draft" />
        <Button x:Name="DiscardRecoveryButton" Content="Discard recovery" IsVisible="False"
                AutomationProperties.Name="Discard separate recovery draft" />
        <Button x:Name="DismissAlertBandButton" Content="Dismiss" IsVisible="False" />
      </StackPanel>
    </Border>
    <analysis:ConditionsBand x:Name="AnalysisConditionsBand" IsVisible="False" />
    <Border x:Name="HistoricalBanner" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,1" Padding="{StaticResource Space2}">
      <TextBlock x:Name="HistoricalBannerText" TextWrapping="Wrap" />
    </Border>
    <Border x:Name="PreviewHiddenBanner" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="{StaticResource Space2}">
      <TextBlock Text="Preview hidden — Apply or Cancel in CAD" />
    </Border>
    </StackPanel>

    <!-- Main Content Area. Reports go to the shell's status strip (DR-STATUS-1); the model area has no status line. -->
    <Grid Grid.Row="1" x:Name="ModelRoot">
      <!-- Start View (shown when no foil is open) -->
      <panes:StartView x:Name="StartCardView" IsVisible="True" />

      <!-- The model-area arrangement (M1.2b2 §11.1): Plan + 3D (2* · 1*), Four views (Plan | 3D over Side | Front),
           or One view. ModelArea.ApplyLayout places the slots; each slot is its view with the label plate over its top-left
           (DR-VIEW-7). The navbar follows the views, over them at the bottom centre and after them in Tab order. -->
      <Border x:Name="PlanContent" IsVisible="False" Background="{DynamicResource CanvasBrush}">
        <Panel>
        <Grid x:Name="ViewArrangementGrid" ColumnDefinitions="2*,1*" RowDefinitions="*,0"
              ColumnSpacing="{StaticResource ViewGutter}" RowSpacing="{StaticResource ViewGutter}">
          <Border x:Name="PlanFrame" Classes="viewFrame">
            <Grid x:Name="PlanSlot">
            <Button x:Name="PlanLabel" Classes="viewLabel" Content="Plan"
                    AutomationProperties.Name="Plan view label. Double-click or Return shows this view alone." />
            <local:PlanCanvas x:Name="PlanCanvas" Focusable="True"
                              BackgroundBrush="{DynamicResource ViewportBrush}"
                              FoilBrush="{DynamicResource PlanFoilBrush}"
                              SelectionBrush="{DynamicResource PlanSelectionBrush}"
                              FocusBrush="{DynamicResource PlanFocusBrush}"
                              MuteBrush="{DynamicResource PlanMuteBrush}"
                              DangerBrush="{DynamicResource PlanDangerBrush}"
                              WarningBrush="{DynamicResource PlanWarningBrush}"
                              SoftBrush="{DynamicResource PlanSoftBrush}" />
            <Border x:Name="AddPointPanel" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="{StaticResource Space4}" Padding="{StaticResource Space2}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
              <StackPanel Spacing="4">
                <TextBlock Text="Add point · from root" />
                <TextBox x:Name="AddPointTextBox" MinWidth="{StaticResource PropValueMinWidth}" Watermark="mm"
                         AutomationProperties.Name="From root in millimetres" />
                <TextBlock x:Name="AddPointError" IsVisible="False" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="AddPointCancelButton" Content="Cancel" />
                  <Button x:Name="AddPointApplyButton" Content="Add point" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="PlanRenderErrorBand" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    Padding="{StaticResource Space2}" HorizontalAlignment="Right" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="PlanRenderErrorText" VerticalAlignment="Center" />
                <Button x:Name="PlanRenderTryAgainButton" Content="Try again" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>

          <Border x:Name="ThreeDFrame" Classes="viewFrame" Grid.Column="1">
            <Grid x:Name="ThreeDSlot">
            <Button x:Name="ThreeDLabel" Classes="viewLabel" Content="3D · Iso" />
            <local:SurfaceRenderer x:Name="ThreeDRenderer" Pane="3d" ClipToBounds="True" ShowGround="True"
                                   GridBrush="{DynamicResource ViewportGridBrush}"
                                   BackgroundBrush="{DynamicResource ViewportBrush}"
                                   ShadeGrazingBrush="{DynamicResource PlanSoftBrush}"
                                   ShadeLitBrush="{DynamicResource FoilShadeLitBrush}"
                                   FoilBrush="{DynamicResource PlanFoilBrush}"
                                   FoilEdgeBrush="{DynamicResource FoilEdgeBrush}"
                                   StationBrush="{DynamicResource PlanSelectionBrush}"
                                   MuteBrush="{DynamicResource PlanMuteBrush}" />
            <!-- V3D: navigation, the view cube (top-right), the axis triad (bottom-left) and the station chip, over the surface. -->
            <local:View3d x:Name="ThreeDView"
                          SoftBrush="{DynamicResource PlanSoftBrush}" InkBrush="{DynamicResource ViewportInkBrush}"
                          MuteBrush="{DynamicResource PlanMuteBrush}" StationBrush="{DynamicResource PlanSelectionBrush}"
                          FocusBrush="{DynamicResource PlanFocusBrush}" ViewportBrush="{DynamicResource ViewportBrush}" />
            <TextBlock x:Name="ThreeDDrawing" Classes="viewOverlay" Text="Drawing…" IsVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel x:Name="ThreeDCaptionStack" VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="4">
              <TextBlock x:Name="ThreeDNote" Classes="viewOverlay" IsVisible="False" TextWrapping="Wrap" />
              <TextBlock x:Name="ThreeDCaption" Classes="viewOverlay" TextWrapping="Wrap"
                         Text="Display · x aft, y starboard, z up · twist about the leading edge" />
            </StackPanel>
            <Border x:Name="ThreeDRenderErrorBand" Classes="viewError" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ThreeDRenderErrorText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="3D view couldn't be drawn. Your foil hasn't changed." />
                <Button x:Name="ThreeDRenderTryAgainButton" Content="Try again" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>

          <Border x:Name="SideFrame" Classes="viewFrame" Grid.Row="1" IsVisible="False">
            <Grid x:Name="SideSlot">
            <Button x:Name="SideLabel" Classes="viewLabel" Content="Side · from starboard" />
            <!-- ELV (§11.1): band (the mesh through the Side camera) over the twist lane; the view styles its band. -->
            <local:ElevationView x:Name="SideElevation" View="Side" ClipToBounds="True"
                                 BackgroundBrush="{DynamicResource ViewportBrush}"
                                 FoilBrush="{DynamicResource PlanFoilBrush}"
                                 FoilEdgeBrush="{DynamicResource FoilEdgeBrush}"
                                 SelectionBrush="{DynamicResource PlanSelectionBrush}"
                                 FocusBrush="{DynamicResource PlanFocusBrush}"
                                 MuteBrush="{DynamicResource PlanMuteBrush}"
                                 SoftBrush="{DynamicResource PlanSoftBrush}"
                                 GridBrush="{DynamicResource ViewportGridBrush}"
                                 InkBrush="{DynamicResource ViewportInkBrush}"
                                 ShadeGrazingBrush="{DynamicResource PlanSoftBrush}"
                                 ShadeLitBrush="{DynamicResource FoilShadeLitBrush}">
              <local:SurfaceRenderer x:Name="SideRenderer" Pane="side" ClipToBounds="True" />
            </local:ElevationView>
            <Border x:Name="SideRenderErrorBand" Classes="viewError" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Side view couldn't be drawn. Your foil hasn't changed." />
                <Button x:Name="SideRenderTryAgainButton" Content="Try again" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>

          <Border x:Name="FrontFrame" Classes="viewFrame" Grid.Row="1" Grid.Column="1" IsVisible="False">
            <Grid x:Name="FrontSlot">
            <Button x:Name="FrontLabel" Classes="viewLabel" Content="Front · looking aft" />
            <!-- ELV (§11.1): band (the mesh through the Front camera, dihedral on the LE line) over the t/c lane. -->
            <local:ElevationView x:Name="FrontElevation" View="Front" ClipToBounds="True"
                                 BackgroundBrush="{DynamicResource ViewportBrush}"
                                 FoilBrush="{DynamicResource PlanFoilBrush}"
                                 FoilEdgeBrush="{DynamicResource FoilEdgeBrush}"
                                 SelectionBrush="{DynamicResource PlanSelectionBrush}"
                                 FocusBrush="{DynamicResource PlanFocusBrush}"
                                 MuteBrush="{DynamicResource PlanMuteBrush}"
                                 SoftBrush="{DynamicResource PlanSoftBrush}"
                                 GridBrush="{DynamicResource ViewportGridBrush}"
                                 InkBrush="{DynamicResource ViewportInkBrush}"
                                 ShadeGrazingBrush="{DynamicResource PlanSoftBrush}"
                                 ShadeLitBrush="{DynamicResource FoilShadeLitBrush}">
              <local:SurfaceRenderer x:Name="FrontRenderer" Pane="front" ClipToBounds="True" />
            </local:ElevationView>
            <Border x:Name="FrontRenderErrorBand" Classes="viewError" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Front view couldn't be drawn. Your foil hasn't changed." />
                <Button x:Name="FrontRenderTryAgainButton" Content="Try again" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>
        </Grid>

        <local:RebuildPopover x:Name="RebuildPopoverView" IsVisible="False"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="{StaticResource RebuildPopoverInset}" />

        <!-- The navbar (§11.7: v10's Fit and Views ▾, plus Display ▾ and Fit Selection). Each control runs a CommandTable row
             through the shell's view-command runner, the same action as its View-menu row; ModelArea fills the menus. -->
        <Border x:Name="Navbar" Classes="navbar">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource NavbarGap}">
            <ToggleButton x:Name="NavCadButton" Classes="navbar" Content="CAD" IsChecked="True"
                          AutomationProperties.Name="CAD area" />
            <ToggleButton x:Name="NavAnalysisButton" Classes="navbar" Content="Analysis"
                          AutomationProperties.Name="Analysis area" />
            <Border Classes="navbar-separator" />
            <Button x:Name="NavViewsButton" Classes="navbar" Content="Views ▾ Plan + 3D">
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="navbar-menu" />
              </Button.Flyout>
            </Button>
            <Button x:Name="NavDisplayButton" Classes="navbar" Content="Display ▾ Shaded">
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="navbar-menu" />
              </Button.Flyout>
            </Button>
            <Border Classes="navbar-separator" />
            <Button x:Name="NavFitButton" Classes="navbar" Content="Fit" />
            <Button x:Name="NavFitSelectionButton" Classes="navbar" Content="Fit Selection" />
          </StackPanel>
        </Border>
        </Panel>
      </Border>

      <local:SectionEditorView x:Name="SectionModeEditor" IsVisible="False" />

      <!-- These bodies move to Dock documents before the shell is shown. The Section document's content (the Section view)
           is the Analysis panel's SectionView, set by the shell. -->
      <Grid x:Name="DetachedDocumentBodies" IsVisible="False">
          <ScrollViewer x:Name="SectionDocumentBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        AutomationProperties.Name="Section">
            <ContentControl x:Name="SectionDocumentHost" />
          </ScrollViewer>

          <Grid x:Name="FoilSourceBody" RowDefinitions="Auto,*" Margin="{StaticResource Space4}">
            <TextBlock Grid.Row="0" x:Name="SourceLabel" Text="Accepted source bytes" />
            <TextBox Grid.Row="1" x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Retained FoilDSL source text" />
          </Grid>

          <local:SectionEditorView x:Name="SectionEditor" />
      </Grid>

      <!-- The warning toast (DESIGN.md §4 Toast): last child, so it draws over the views at the model area's bottom-right
           and never over the Properties dock or the strip. Not a live region: the strip speaks its text. -->
      <Border x:Name="WarningToast" Classes="toast" IsVisible="False" AutomationProperties.Name="Warning">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="toast-rail" Width="{StaticResource RailWidth}" />
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource ToastPadding}">
            <Path x:Name="ToastIcon" Grid.Column="0" Classes="status-icon warning toast-icon" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="ToastText" Grid.Column="1" Margin="{StaticResource ToastTextGap}" />
            <Button x:Name="ToastDismissButton" Grid.Column="2" Classes="toast-dismiss" Content="×"
                    AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
