<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CfdWorkbench.Desktop"
             xmlns:panes="using:CfdWorkbench.Desktop.Panes"
             x:Class="CfdWorkbench.Desktop.ModelArea">
  <UserControl.Styles>
    <!-- View labels (v10 .vlabel, ≥ 24 × 24) and overlay text sit on a viewport-soft plate, never on the surface. -->
    <Style Selector="Button.viewLabel">
      <Setter Property="Background" Value="{DynamicResource PlanSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ViewportInkBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="{StaticResource Space2}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="TextBlock.viewOverlay">
      <Setter Property="Foreground" Value="{DynamicResource ViewportInkBrush}" />
      <Setter Property="Background" Value="{DynamicResource PlanSoftBrush}" />
      <Setter Property="Padding" Value="{StaticResource Space2}" />
    </Style>
    <Style Selector="Border.viewError">
      <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{StaticResource Space2}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- DR-VIEW-1: each view is framed in a 1 px line; the 4 px gutter between frames shows the canvas colour behind the grid. -->
    <Style Selector="Border.viewFrame">
      <Setter Property="Background" Value="{DynamicResource ViewportBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <!-- Alert Band -->
    <Border Grid.Row="0" x:Name="AlertBand" IsVisible="False" AutomationProperties.LiveSetting="Assertive" Background="{DynamicResource SurfaceSoftBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="{StaticResource Space2}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="AlertBandText" Text="" VerticalAlignment="Center" />
        <Button x:Name="BandLocateButton" Content="Locate…" IsVisible="False" />
        <Button x:Name="BandTryAgainButton" Content="Try again" IsVisible="False" />
        <Button x:Name="BandOpenAnotherButton" Content="Open another file…" IsVisible="False" />
        <Button x:Name="BandRemoveRecentButton" Content="Remove from Recent" IsVisible="False" />
        <Button x:Name="AcceptIdsButton" Content="Accept candidate IDs" IsVisible="False"
                AutomationProperties.Name="Accept explicit ID insertion after comparing source" />
        <Button x:Name="ResumeRecoveryButton" Content="Resume draft" IsVisible="False"
                AutomationProperties.Name="Resume separate recovery draft" />
        <Button x:Name="DiscardRecoveryButton" Content="Discard recovery" IsVisible="False"
                AutomationProperties.Name="Discard separate recovery draft" />
        <Button x:Name="DismissAlertBandButton" Content="Dismiss" IsVisible="False" />
      </StackPanel>
    </Border>

    <!-- Main Content Area. Reports go to the shell's status strip (DR-STATUS-1); the model area has no status line. -->
    <Grid Grid.Row="1" x:Name="ModelRoot">
      <!-- Start View (shown when no foil is open) -->
      <panes:StartView x:Name="StartCardView" IsVisible="True" />

      <!-- The model-area arrangement (M1.2b2 §11.1): Plan + 3D (2* · 1*), Four views (Plan | 3D over Side | Front),
           or One view. ModelArea.ApplyLayout places the slots; each slot is a label row over its view. -->
      <Border x:Name="PlanContent" IsVisible="False" Background="{DynamicResource CanvasBrush}">
        <Grid x:Name="ViewArrangementGrid" ColumnDefinitions="2*,1*" RowDefinitions="*,0"
              ColumnSpacing="{StaticResource ViewGutter}" RowSpacing="{StaticResource ViewGutter}">
          <Border x:Name="PlanFrame" Classes="viewFrame">
            <Grid x:Name="PlanSlot" RowDefinitions="Auto,*">
            <Button x:Name="PlanLabel" Grid.Row="0" Classes="viewLabel" Content="Plan"
                    AutomationProperties.Name="Plan view label. Double-click or Return shows this view alone." />
            <local:PlanCanvas Grid.Row="1" x:Name="PlanCanvas" Focusable="True"
                              BackgroundBrush="{DynamicResource ViewportBrush}"
                              FoilBrush="{DynamicResource PlanFoilBrush}"
                              SelectionBrush="{DynamicResource PlanSelectionBrush}"
                              FocusBrush="{DynamicResource PlanFocusBrush}"
                              MuteBrush="{DynamicResource PlanMuteBrush}"
                              DangerBrush="{DynamicResource PlanDangerBrush}"
                              WarningBrush="{DynamicResource PlanWarningBrush}"
                              SoftBrush="{DynamicResource PlanSoftBrush}" />
            <Border Grid.Row="1" x:Name="PlanRenderErrorBand" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    Padding="{StaticResource Space2}" HorizontalAlignment="Right" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="PlanRenderErrorText" VerticalAlignment="Center" />
                <Button x:Name="PlanRenderTryAgainButton" Content="Try again" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>

          <Border x:Name="ThreeDFrame" Classes="viewFrame" Grid.Column="1">
            <Grid x:Name="ThreeDSlot" RowDefinitions="Auto,*">
            <Button x:Name="ThreeDLabel" Grid.Row="0" Classes="viewLabel" Content="3D · Iso" />
            <local:SurfaceRenderer Grid.Row="1" x:Name="ThreeDRenderer" Pane="3d" ClipToBounds="True"
                                   BackgroundBrush="{DynamicResource ViewportBrush}"
                                   ShadeGrazingBrush="{DynamicResource PlanSoftBrush}"
                                   ShadeLitBrush="{DynamicResource FoilShadeLitBrush}"
                                   FoilBrush="{DynamicResource PlanFoilBrush}"
                                   FoilEdgeBrush="{DynamicResource FoilEdgeBrush}"
                                   StationBrush="{DynamicResource PlanSelectionBrush}"
                                   MuteBrush="{DynamicResource PlanMuteBrush}" />
            <TextBlock Grid.Row="1" x:Name="ThreeDDrawing" Classes="viewOverlay" Text="Drawing…" IsVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="{StaticResource Space2}" Spacing="4">
              <TextBlock x:Name="ThreeDNote" Classes="viewOverlay" IsVisible="False" TextWrapping="Wrap" />
              <TextBlock x:Name="ThreeDCaption" Classes="viewOverlay" TextWrapping="Wrap"
                         Text="Display · x aft, y starboard, z up · twist about the leading edge" />
            </StackPanel>
            <Border Grid.Row="1" x:Name="ThreeDRenderErrorBand" Classes="viewError" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ThreeDRenderErrorText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="3D view couldn't be drawn. Your foil hasn't changed." />
                <Button x:Name="ThreeDRenderTryAgainButton" Content="Try again" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>

          <Border x:Name="SideFrame" Classes="viewFrame" Grid.Row="1" IsVisible="False">
            <Grid x:Name="SideSlot" RowDefinitions="Auto,*">
            <Button x:Name="SideLabel" Grid.Row="0" Classes="viewLabel" Content="Side · from starboard" />
            <local:SurfaceRenderer Grid.Row="1" x:Name="SideRenderer" Pane="side" ClipToBounds="True"
                                   BackgroundBrush="{DynamicResource ViewportBrush}"
                                   ShadeGrazingBrush="{DynamicResource PlanSoftBrush}"
                                   ShadeLitBrush="{DynamicResource FoilShadeLitBrush}"
                                   FoilBrush="{DynamicResource PlanFoilBrush}"
                                   FoilEdgeBrush="{DynamicResource FoilEdgeBrush}"
                                   StationBrush="{DynamicResource PlanSelectionBrush}"
                                   MuteBrush="{DynamicResource PlanMuteBrush}" />
            <Border Grid.Row="1" x:Name="SideRenderErrorBand" Classes="viewError" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Side view couldn't be drawn. Your foil hasn't changed." />
                <Button x:Name="SideRenderTryAgainButton" Content="Try again" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>

          <Border x:Name="FrontFrame" Classes="viewFrame" Grid.Row="1" Grid.Column="1" IsVisible="False">
            <Grid x:Name="FrontSlot" RowDefinitions="Auto,*">
            <Button x:Name="FrontLabel" Grid.Row="0" Classes="viewLabel" Content="Front · looking aft" />
            <local:SurfaceRenderer Grid.Row="1" x:Name="FrontRenderer" Pane="front" ClipToBounds="True"
                                   BackgroundBrush="{DynamicResource ViewportBrush}"
                                   ShadeGrazingBrush="{DynamicResource PlanSoftBrush}"
                                   ShadeLitBrush="{DynamicResource FoilShadeLitBrush}"
                                   FoilBrush="{DynamicResource PlanFoilBrush}"
                                   FoilEdgeBrush="{DynamicResource FoilEdgeBrush}"
                                   StationBrush="{DynamicResource PlanSelectionBrush}"
                                   MuteBrush="{DynamicResource PlanMuteBrush}" />
            <Border Grid.Row="1" x:Name="FrontRenderErrorBand" Classes="viewError" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Front view couldn't be drawn. Your foil hasn't changed." />
                <Button x:Name="FrontRenderTryAgainButton" Content="Try again" />
              </StackPanel>
            </Border>
          </Grid>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="Plan3DContent" IsVisible="False" Background="{DynamicResource ViewportBrush}" Padding="{StaticResource Space3}">
            <Grid RowDefinitions="Auto,*,Auto">
              <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource ViewportInkBrush}"
                           Text="Isometric · certified XYZ point samples" FontWeight="SemiBold" />
                <TextBlock x:Name="ViewportProvenance" Foreground="{DynamicResource ViewportInkBrush}"
                           HorizontalAlignment="Right" Text="Empty" />
              </DockPanel>
              <local:Viewport Grid.Row="1" x:Name="FoilViewport" Focusable="True" BackgroundBrush="{DynamicResource ViewportBrush}"
                              AnnotationWidth="{StaticResource ViewportAnnotationWidth}" AnnotationHeight="{StaticResource ViewportAnnotationHeight}"
                              GridBrush="{DynamicResource ViewportGridBrush}" FoilBrush="{DynamicResource FoilBrush}"
                              StationBrush="{DynamicResource StationBrush}"
                              AutomationProperties.Name="Physical XYZ isometric foil; root, interior and tip sampled stations; inspect coordinate and control data in Navigator" />
              <TextBlock Grid.Row="2" Foreground="{DynamicResource ViewportInkBrush}"
                         Text="Axis triad: ↘ +x aft · ↙ +y span · ↑ +z height (m) · one uniform scale · segment error Not assessed" TextWrapping="Wrap" />
            </Grid>
      </Border>

      <!-- These three bodies move to Dock documents before the shell is shown. -->
      <Grid x:Name="DetachedDocumentBodies" IsVisible="False">
          <StackPanel x:Name="SectionSampleBody" Margin="{StaticResource Space4}" Spacing="8">
            <TextBlock x:Name="SectionPosition" Classes="heading" Text="Physical X/Z section · η 0.5" />
            <local:Viewport x:Name="SectionViewport" SectionMode="True" Height="{StaticResource SectionViewportHeight}"
                            BackgroundBrush="{DynamicResource ViewportBrush}"
                            AnnotationWidth="{StaticResource ViewportAnnotationWidth}" AnnotationHeight="{StaticResource SectionAnnotationHeight}"
                            GridBrush="{DynamicResource ViewportGridBrush}" FoilBrush="{DynamicResource FoilBrush}"
                            StationBrush="{DynamicResource StationBrush}"
                            AutomationProperties.Name="Five certified physical x and z section samples at the labelled interior eta, upper and lower trailing edges separate" />
            <TextBlock x:Name="SectionReadout" Text="Open a certified foil to inspect normalized z/c." TextWrapping="Wrap"
                       AutomationProperties.Name="Normalized section upper and lower enclosure" />
            <TextBlock Classes="caption" Text="Physical points (m) and normalized z/c at x/c 0.5; sampled segment error Not assessed." />
            <TextBlock Classes="caption" Text="Analysis Unavailable — no method implemented." />
          </StackPanel>

          <Grid x:Name="FoilSourceBody" RowDefinitions="Auto,*" Margin="{StaticResource Space4}">
            <TextBlock Grid.Row="0" x:Name="SourceLabel" Text="Accepted source bytes" />
            <TextBox Grid.Row="1" x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Retained FoilDSL source text" />
          </Grid>

          <local:SectionEditorView x:Name="SectionEditor" />
      </Grid>

      <!-- The warning toast (DESIGN.md §4 Toast): last child, so it draws over the views at the model area's bottom-right
           and never over the Properties dock or the strip. Not a live region: the strip speaks its text. -->
      <Border x:Name="WarningToast" Classes="toast" IsVisible="False" AutomationProperties.Name="Warning">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Classes="toast-rail" Width="{StaticResource RailWidth}" />
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource ToastPadding}">
            <Path x:Name="ToastIcon" Grid.Column="0" Classes="status-icon warning toast-icon" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="ToastText" Grid.Column="1" Margin="{StaticResource ToastTextGap}" />
            <Button x:Name="ToastDismissButton" Grid.Column="2" Classes="toast-dismiss" Content="×"
                    AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
