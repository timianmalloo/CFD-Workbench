<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CfdWorkbench.Desktop"
             xmlns:panes="using:CfdWorkbench.Desktop.Panes"
             x:Class="CfdWorkbench.Desktop.ModelArea">
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Alert Band -->
    <Border Grid.Row="0" x:Name="AlertBand" IsVisible="False" AutomationProperties.LiveSetting="Assertive" Background="{DynamicResource SurfaceSoftBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="{StaticResource Space2}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="AlertBandText" Text="" VerticalAlignment="Center" />
        <Button x:Name="BandLocateButton" Content="Locate…" IsVisible="False" />
        <Button x:Name="BandTryAgainButton" Content="Try again" IsVisible="False" />
        <Button x:Name="BandOpenAnotherButton" Content="Open another file…" IsVisible="False" />
        <Button x:Name="BandRemoveRecentButton" Content="Remove from Recent" IsVisible="False" />
        <Button x:Name="AcceptIdsButton" Content="Accept candidate IDs" IsVisible="False"
                AutomationProperties.Name="Accept explicit ID insertion after comparing source" />
        <Button x:Name="ResumeRecoveryButton" Content="Resume draft" IsVisible="False"
                AutomationProperties.Name="Resume separate recovery draft" />
        <Button x:Name="DiscardRecoveryButton" Content="Discard recovery" IsVisible="False"
                AutomationProperties.Name="Discard separate recovery draft" />
        <Button x:Name="DismissAlertBandButton" Content="Dismiss" IsVisible="False" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="1" x:Name="StatusText" IsVisible="False" AutomationProperties.LiveSetting="Polite"
               Margin="{StaticResource Space2}" TextWrapping="Wrap" />

    <!-- Main Content Area -->
    <Grid Grid.Row="2">
      <!-- Start View (shown when no foil is open) -->
      <panes:StartView x:Name="StartCardView" IsVisible="True" />

      <!-- Document Tabs (shown when foil is open) -->
      <TabControl x:Name="DocumentTabs" IsVisible="False" AutomationProperties.Name="Section and source document tabs">
        <!-- Plan + 3D Tab -->
        <TabItem x:Name="Plan3DTab" Header="Plan + 3D">
          <Border Background="{DynamicResource ViewportBrush}" Padding="{StaticResource Space3}">
            <Grid RowDefinitions="Auto,*,Auto">
              <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Left" Foreground="{DynamicResource ViewportInkBrush}"
                           Text="Isometric · certified XYZ point samples" FontWeight="SemiBold" />
                <TextBlock x:Name="ViewportProvenance" Foreground="{DynamicResource ViewportInkBrush}"
                           HorizontalAlignment="Right" Text="Empty" />
              </DockPanel>
              <local:Viewport Grid.Row="1" x:Name="FoilViewport" Focusable="True" BackgroundBrush="{DynamicResource ViewportBrush}"
                              AnnotationWidth="{StaticResource ViewportAnnotationWidth}" AnnotationHeight="{StaticResource ViewportAnnotationHeight}"
                              GridBrush="{DynamicResource ViewportGridBrush}" FoilBrush="{DynamicResource FoilBrush}"
                              StationBrush="{DynamicResource StationBrush}"
                              AutomationProperties.Name="Physical XYZ isometric foil; root, interior and tip sampled stations; inspect coordinate and control data in Navigator" />
              <TextBlock Grid.Row="2" Foreground="{DynamicResource ViewportInkBrush}"
                         Text="Axis triad: ↘ +x aft · ↙ +y span · ↑ +z height (m) · one uniform scale · segment error Not assessed" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </TabItem>

        <!-- Section sample Tab (Ruling 55) -->
        <TabItem x:Name="SectionSampleTab" Header="Section sample">
          <StackPanel Margin="{StaticResource Space4}" Spacing="8">
            <TextBlock x:Name="SectionPosition" Classes="heading" Text="Physical X/Z section · η 0.5" />
            <local:Viewport x:Name="SectionViewport" SectionMode="True" Height="{StaticResource SectionViewportHeight}"
                            BackgroundBrush="{DynamicResource ViewportBrush}"
                            AnnotationWidth="{StaticResource ViewportAnnotationWidth}" AnnotationHeight="{StaticResource SectionAnnotationHeight}"
                            GridBrush="{DynamicResource ViewportGridBrush}" FoilBrush="{DynamicResource FoilBrush}"
                            StationBrush="{DynamicResource StationBrush}"
                            AutomationProperties.Name="Five certified physical x and z section samples at the labelled interior eta, upper and lower trailing edges separate" />
            <TextBlock x:Name="SectionReadout" Text="Open a certified foil to inspect normalized z/c." TextWrapping="Wrap"
                       AutomationProperties.Name="Normalized section upper and lower enclosure" />
            <TextBlock Classes="caption" Text="Physical points (m) and normalized z/c at x/c 0.5; sampled segment error Not assessed." />
            <TextBlock Classes="caption" Text="Analysis Unavailable — no method implemented." />
          </StackPanel>
        </TabItem>

        <!-- Foil source Tab -->
        <TabItem x:Name="FoilSourceTab" Header="Foil source">
          <Grid RowDefinitions="Auto,*" Margin="{StaticResource Space4}">
            <TextBlock Grid.Row="0" x:Name="SourceLabel" Text="Accepted source bytes" />
            <TextBox Grid.Row="1" x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Retained FoilDSL source text" />
          </Grid>
        </TabItem>

        <!-- Section Tab (Ruling 55) -->
        <TabItem x:Name="SectionTab" Header="Section">
          <local:SectionEditorView x:Name="SectionEditor" />
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
