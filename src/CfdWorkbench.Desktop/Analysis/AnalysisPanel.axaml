<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CfdWorkbench.Desktop.Analysis.AnalysisPanel" AutomationProperties.Name="Analysis results"
             FontFamily="{StaticResource PropFontFamily}">
  <!-- The Analysis bottom panel (A3a §18.5 rows 25, 28, 31): a shell slot shown in Analysis only. The tabs read the selected
       run's projection (AnalysisView), never the latest attempt: after a failed Evaluate they keep the previous run
       Historical beside the error card. Checks has no data source (no DRC exists, OD-4 a), so it is omitted. -->
  <UserControl.Styles>
    <Style Selector="TabControl#PanelTabs TabItem"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource NavbarButtonPadding}" /></Style>
    <Style Selector="Border.pnl-bar"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="Height" Value="10" /><Setter Property="CornerRadius" Value="2" /></Style>
    <Style Selector="Border.pnl-error"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="{StaticResource Space1}" /></Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Space1}" Spacing="{StaticResource StackGap2}">
        <!-- The banner and the skeleton share one line, so while Running the chart keeps the height its x tick row needs (Ruling 101 Q4). -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource StackGap2}">
          <TextBlock x:Name="PanelBanner" Classes="pnl-note" IsVisible="False" VerticalAlignment="Center" />
          <StackPanel x:Name="PanelSkeleton" Orientation="Horizontal" Spacing="{StaticResource StackGap2}" VerticalAlignment="Center"
                      IsVisible="False" AutomationProperties.Name="Evaluating">
            <Border x:Name="SkeletonLong" Classes="pnl-bar" HorizontalAlignment="Left" />
            <Border x:Name="SkeletonShort" Classes="pnl-bar" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
        <Border x:Name="PanelErrorCard" Classes="pnl-error" IsVisible="False">
          <TextBlock x:Name="PanelErrorText" Classes="pnl-cell" AutomationProperties.LiveSetting="Assertive" />
        </Border>
      </StackPanel>
      <TabControl x:Name="PanelTabs" AutomationProperties.Name="Analysis result tabs">
        <TabItem x:Name="LoadingTab" Header="Spanwise loading" AutomationProperties.Name="Spanwise loading">
          <Grid>
            <TextBlock x:Name="LoadingEmpty" Classes="pnl-note" IsVisible="False" Margin="{StaticResource Space2}" />
            <ContentControl x:Name="LoadingHost" Margin="{StaticResource Space1}" />
          </Grid>
        </TabItem>
        <TabItem x:Name="SectionTab" Header="Section" AutomationProperties.Name="Section">
          <!-- Ruling 124: the full Section view is the model area's Section document; this tab is its one-line summary. -->
          <Grid x:Name="SectionSummary" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="{StaticResource Space1}" VerticalAlignment="Center">
            <TextBlock x:Name="SectionSummaryStation" Grid.Column="0" Classes="pnl-head" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="SectionSummaryCl" Grid.Column="1" Classes="pnl-cell" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock x:Name="SectionSummaryCp" Grid.Column="2" Classes="pnl-cell" VerticalAlignment="Center" />
            <Button x:Name="OpenInMainAreaButton" Grid.Column="4" Classes="modebar outline" />
          </Grid>
        </TabItem>
        <TabItem x:Name="LoadsTab" Header="Loads" AutomationProperties.Name="Loads">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LoadsBody" Margin="{StaticResource Space1}" /></ScrollViewer>
        </TabItem>
        <TabItem x:Name="ProvenanceTab" Header="Provenance" AutomationProperties.Name="Provenance">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ProvenanceBody" Margin="{StaticResource Space1}" /></ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Border>
</UserControl>
