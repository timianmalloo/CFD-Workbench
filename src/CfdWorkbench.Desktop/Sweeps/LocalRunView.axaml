<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CfdWorkbench.Desktop.Sweeps.LocalRunView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="{StaticResource Space3}">
    <!-- Header & Run/Cancel controls -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
      <StackPanel Spacing="{StaticResource StackGap2}">
        <StackPanel Orientation="Vertical" Spacing="{StaticResource StackGap1}">
          <TextBlock x:Name="RunTitleText" Text="2. Local queue (in-process)" FontSize="{StaticResource HeadingSize}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
          <TextBlock x:Name="PinSummaryText" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Orientation="Horizontal" Classes="toolbar-wrap">
          <Button x:Name="RunLocalButton" Classes="primary" Content="Run locally" AutomationProperties.Name="Run queued sweep locally in process" />
          <Button x:Name="CancelRunButton" Content="Cancel" IsEnabled="False" AutomationProperties.Name="Cancel active local sweep run" />
          <Button x:Name="OpenResultsButton" Content="Open Polars →" IsEnabled="False" AutomationProperties.Name="Open sweep polar charts" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Status banner & static determinate progress bar (DESIGN.md §6 Motion:None) -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}" Margin="{StaticResource Space1}">
      <StackPanel Spacing="{StaticResource StackGap1}">
        <TextBlock x:Name="RunStatusBanner" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar x:Name="RunProgressBar" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" />
      </StackPanel>
    </Border>

    <!-- Per-case status ledger with one-click Retry sample -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="{StaticResource HairlineThickness}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="CaseRowsHost" Spacing="{StaticResource StackGap1}" Margin="{StaticResource Space2}" />
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
