<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assistant="using:CfdWorkbench.Desktop.Assistant"
             x:Class="CfdWorkbench.Desktop.Sweeps.ExperimentSetupView">
  <!-- XS-03 / UX-17: Experiment setup defines and previews cases only; ZERO Run button exists in this view. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{StaticResource Space3}">
    <!-- Header & actions (New sweep, New version, Refresh preview, Queue, Open in Run jump chip) -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource StackGap2}">
          <Button x:Name="NewSweepButton" Content="New sweep" AutomationProperties.Name="Create a new sweep draft" />
          <Button x:Name="NewVersionButton" Content="New version" AutomationProperties.Name="Create a new sweep version from selected sweep" />
          <Button x:Name="RefreshPreviewButton" Content="Refresh preview" AutomationProperties.Name="Refresh case preview" />
          <Button x:Name="QueueButton" Content="Queue" IsEnabled="False" AutomationProperties.Name="Queue immutable sweep version" />
          <Button x:Name="OpenInRunButton" Content="Open in Run →" IsEnabled="False" AutomationProperties.Name="Open queued sweep in Run view" />
        </StackPanel>
        <StackPanel Orientation="Vertical" Spacing="{StaticResource StackGap1}">
          <TextBlock Text="Experiment setup" FontSize="{StaticResource HeadingSize}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
          <TextBlock x:Name="QueuedStatusText" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Banners: stale preview or validation error -->
    <StackPanel Grid.Row="1" Spacing="{StaticResource StackGap1}" Margin="{StaticResource Space1}">
      <Border x:Name="StaleBanner" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
              BorderBrush="{DynamicResource WarningBrush}" BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
        <TextBlock x:Name="StaleBannerText" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
      </Border>
      <Border x:Name="ValidationBanner" IsVisible="False" Background="{DynamicResource SurfaceSoftBrush}"
              BorderBrush="{DynamicResource DangerBrush}" BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}">
        <TextBlock x:Name="ValidationBannerText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive" />
      </Border>
    </StackPanel>

    <!-- Body: empty state OR configurator + bounded preview table -->
    <Grid Grid.Row="2">
      <Border x:Name="EmptyStatePanel" IsVisible="True" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space4}">
        <StackPanel Spacing="{StaticResource StackGap2}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="EmptyStateText" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" FontSize="{StaticResource BodySize}" />
          <Button x:Name="EmptyNewSweepButton" Content="New sweep" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Grid x:Name="EditorGrid" IsVisible="False" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource StackGap3}">
        <!-- Left: Configurator inputs -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space3}"
                  MinWidth="{StaticResource SweepInspectorWidth}" MaxWidth="{StaticResource SweepInspectorWidth}">
            <StackPanel Spacing="{StaticResource StackGap2}">
              <assistant:AssistantPromptBar x:Name="ExperimentAssistantBar" />

              <TextBlock Text="Sweep name" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <TextBox x:Name="SweepNameBox" AutomationProperties.Name="Sweep name" />

              <TextBlock Text="Case source" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <StackPanel Spacing="{StaticResource StackGap1}">
                <RadioButton x:Name="SourceCartesianRadio" GroupName="SweepSource" Content="Angles × speeds" IsChecked="True" />
                <RadioButton x:Name="SourceGoalRadio" GroupName="SweepSource" Content="Goal-state operating points" IsEnabled="False" />
                <TextBlock x:Name="GoalSourceNote" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>

              <TextBlock Text="Local solver tier" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <StackPanel Spacing="{StaticResource StackGap1}">
                <RadioButton x:Name="TierVlmRadio" GroupName="SweepTier" Content="VLM + strip · local calculation" IsChecked="True" />
                <RadioButton x:Name="TierEstimatorRadio" GroupName="SweepTier" Content="Estimator · local calculation" />
              </StackPanel>

              <TextBlock Text="Speeds (comma-separated)" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StackGap1}">
                <TextBox x:Name="SpeedsBox" Grid.Column="0" AutomationProperties.Name="Sweep speeds" />
                <ComboBox x:Name="SpeedUnitBox" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Speed unit">
                  <ComboBoxItem Content="kn" />
                  <ComboBoxItem Content="m/s" />
                </ComboBox>
              </Grid>

              <TextBlock Text="Angles α (°, comma-separated)" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <TextBox x:Name="AnglesBox" AutomationProperties.Name="Sweep angles in degrees" />

              <TextBlock Text="Water (ITTC 0–50 °C)" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StackGap1}">
                <TextBox x:Name="WaterTempBox" Grid.Column="0" AutomationProperties.Name="Water temperature in Celsius" />
                <CheckBox x:Name="SaltWaterCheck" Grid.Column="1" Content="Salt" IsChecked="True" />
              </Grid>

              <CheckBox x:Name="DepthSetCheck" Content="Set reference depth h_ref (m)" IsChecked="True" />
              <TextBox x:Name="DepthBox" AutomationProperties.Name="Reference depth h_ref in metres" />
            </StackPanel>
          </Border>
        </ScrollViewer>

        <!-- Right: Resource estimate + bounded preview table -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}" Padding="{StaticResource Space2}" Margin="{StaticResource PropLineBelow}">
            <StackPanel Spacing="{StaticResource StackGap1}">
              <TextBlock x:Name="PreviewCountText" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
              <TextBlock x:Name="EstimateWallText" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock x:Name="EstimateStorageText" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock x:Name="BasisPreviewText" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="{StaticResource HairlineThickness}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <StackPanel x:Name="PreviewRowsHost" Spacing="{StaticResource StackGap1}" Margin="{StaticResource Space2}" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- Footer note (SWP-COPY-2) -->
    <TextBlock Grid.Row="3" x:Name="FooterNoteText" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}"
               Margin="{StaticResource Space1}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
