<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sweeps="using:CfdWorkbench.Desktop.Sweeps"
             x:Class="CfdWorkbench.Desktop.Sweeps.SweepsWorkspaceView">
  <!-- Area 4 Experiment / Sweeps workspace segment hosting three discrete sub-tabs (Ruling 277: no bottom navbar clearance). -->
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource CanvasBrush}">
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="{StaticResource PropRuleBottom}" Padding="{StaticResource Space2}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource StackGap2}">
        <WrapPanel Grid.Column="0" Orientation="Horizontal" Classes="toolbar-wrap" VerticalAlignment="Center">
          <ToggleButton x:Name="SubTabSetupButton" Content="1. Sweep setup" IsChecked="True"
                        AutomationProperties.Name="1. Sweep setup — Experiment setup sub-tab" />
          <ToggleButton x:Name="SubTabRunButton" Content="2. Local queue"
                        AutomationProperties.Name="2. Local queue — Local Run sub-tab" />
          <ToggleButton x:Name="SubTabResultsButton" Content="3. Polars"
                        AutomationProperties.Name="3. Polars — Sweep Results sub-tab" />
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource StackGap2}" VerticalAlignment="Center">
          <TextBlock Text="Sweep:" VerticalAlignment="Center" FontSize="{StaticResource CaptionSize}" Foreground="{DynamicResource MutedBrush}" />
          <ComboBox x:Name="ExperimentPicker" MinWidth="{StaticResource SweepInputMinWidth}" AutomationProperties.Name="Select stored sweep experiment" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <sweeps:ExperimentSetupView x:Name="SetupView" IsVisible="True" />
      <sweeps:LocalRunView x:Name="RunView" IsVisible="False" />
      <sweeps:SweepResultsView x:Name="ResultsView" IsVisible="False" />
    </Panel>
  </Grid>
</UserControl>
