<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CfdWorkbench.Desktop" xmlns:dock="using:Dock.Avalonia.Controls">
  <Styles.Resources>
    <ResourceDictionary>
    <Color x:Key="DarkCanvasColor">#172326</Color>
    <Color x:Key="DarkSurfaceColor">#1e2d31</Color>
    <Color x:Key="DarkSoftColor">#2a3d40</Color>
    <Color x:Key="DarkInkColor">#ebf3f0</Color>
    <Color x:Key="DarkMutedColor">#b2c4bf</Color>
    <Color x:Key="DarkLineColor">#49605b</Color>
    <Color x:Key="DarkPrimaryColor">#88d8c6</Color>
    <Color x:Key="DarkOnPrimaryColor">#172326</Color>
    <Color x:Key="DarkDangerColor">#ffaeb5</Color>
    <Color x:Key="HighContrastBackgroundColor">#000000</Color>
    <Color x:Key="HighContrastInkColor">#ffffff</Color>
    <Color x:Key="HighContrastAccentColor">#ffee58</Color>
    <Color x:Key="HighContrastStationColor">#00ffff</Color>
    <Color x:Key="DarkControlLineColor">#79928c</Color>
    <Color x:Key="DarkWarningColor">#efc576</Color>
    <Color x:Key="DarkSelectionColor">#274c47</Color>
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoftColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="ViewportBrush" Color="{StaticResource ViewportColor}" />
        <SolidColorBrush x:Key="ViewportGridBrush" Color="{StaticResource ViewportGridColor}" />
        <SolidColorBrush x:Key="ViewportInkBrush" Color="{StaticResource ViewportInkColor}" />
        <SolidColorBrush x:Key="FoilBrush" Color="{StaticResource FoilColor}" />
        <SolidColorBrush x:Key="StationBrush" Color="{StaticResource StationColor}" />
        <SolidColorBrush x:Key="PlanFoilBrush" Color="{StaticResource FoilColor}" />
        <SolidColorBrush x:Key="PlanSelectionBrush" Color="{StaticResource StationColor}" />
        <SolidColorBrush x:Key="PlanFocusBrush" Color="{StaticResource FocusRingViewportColor}" />
        <SolidColorBrush x:Key="PlanMuteBrush" Color="{StaticResource ViewportMuteColor}" />
        <SolidColorBrush x:Key="PlanDangerBrush" Color="{StaticResource DangerViewportColor}" />
        <SolidColorBrush x:Key="PlanWarningBrush" Color="{StaticResource WarningViewportColor}" />
        <SolidColorBrush x:Key="PlanSoftBrush" Color="{StaticResource ViewportSoftColor}" />
        <SolidColorBrush x:Key="FoilShadeLitBrush" Color="{StaticResource FoilShadeLitColor}" />
        <SolidColorBrush x:Key="FoilEdgeBrush" Color="{StaticResource FoilEdgeColor}" />
        <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ControlLineBrush" Color="{StaticResource ControlLineColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="OnSelectionBrush" Color="{StaticResource InkColor}" />
      </ResourceDictionary>
      <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource DarkCanvasColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource DarkSurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource DarkSoftColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource DarkInkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource DarkMutedColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource DarkLineColor}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
        <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource DarkOnPrimaryColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DarkDangerColor}" />
        <SolidColorBrush x:Key="ViewportBrush" Color="{StaticResource ViewportColor}" />
        <SolidColorBrush x:Key="ViewportGridBrush" Color="{StaticResource ViewportGridColor}" />
        <SolidColorBrush x:Key="ViewportInkBrush" Color="{StaticResource ViewportInkColor}" />
        <SolidColorBrush x:Key="FoilBrush" Color="{StaticResource FoilColor}" />
        <SolidColorBrush x:Key="StationBrush" Color="{StaticResource StationColor}" />
        <SolidColorBrush x:Key="PlanFoilBrush" Color="{StaticResource FoilColor}" />
        <SolidColorBrush x:Key="PlanSelectionBrush" Color="{StaticResource StationColor}" />
        <SolidColorBrush x:Key="PlanFocusBrush" Color="{StaticResource FocusRingViewportColor}" />
        <SolidColorBrush x:Key="PlanMuteBrush" Color="{StaticResource ViewportMuteColor}" />
        <SolidColorBrush x:Key="PlanDangerBrush" Color="{StaticResource DangerViewportColor}" />
        <SolidColorBrush x:Key="PlanWarningBrush" Color="{StaticResource WarningViewportColor}" />
        <SolidColorBrush x:Key="PlanSoftBrush" Color="{StaticResource ViewportSoftColor}" />
        <SolidColorBrush x:Key="FoilShadeLitBrush" Color="{StaticResource FoilShadeLitColor}" />
        <SolidColorBrush x:Key="FoilEdgeBrush" Color="{StaticResource FoilEdgeColor}" />
        <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
        <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource DarkInkColor}" />
        <SolidColorBrush x:Key="ControlLineBrush" Color="{StaticResource DarkControlLineColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource DarkWarningColor}" />
        <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource DarkSelectionColor}" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource DarkPrimaryColor}" />
        <SolidColorBrush x:Key="OnSelectionBrush" Color="{StaticResource DarkInkColor}" />
      </ResourceDictionary>
      <ResourceDictionary x:Key="{x:Static local:NativeReviewThemes.HighContrast}">
        <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource HighContrastBackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource HighContrastBackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource HighContrastBackgroundColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource HighContrastBackgroundColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="ViewportBrush" Color="{StaticResource HighContrastBackgroundColor}" />
        <SolidColorBrush x:Key="ViewportGridBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="ViewportInkBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="FoilBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="StationBrush" Color="{StaticResource HighContrastStationColor}" />
        <SolidColorBrush x:Key="PlanFoilBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="PlanSelectionBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="PlanFocusBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="PlanMuteBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="PlanDangerBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="PlanWarningBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="PlanSoftBrush" Color="{StaticResource HighContrastBackgroundColor}" />
        <SolidColorBrush x:Key="FoilShadeLitBrush" Color="{StaticResource FoilShadeLitColor}" />
        <SolidColorBrush x:Key="FoilEdgeBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="ControlLineBrush" Color="{StaticResource HighContrastInkColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource HighContrastAccentColor}" />
        <SolidColorBrush x:Key="OnSelectionBrush" Color="{StaticResource HighContrastBackgroundColor}" />
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Color x:Key="CanvasColor">#f0f2f1</Color>
    <Color x:Key="SurfaceColor">#fbfcfb</Color>
    <Color x:Key="SurfaceSoftColor">#e8edeb</Color>
    <Color x:Key="InkColor">#1b2929</Color>
    <Color x:Key="MutedColor">#526362</Color>
    <Color x:Key="LineColor">#c9d3cf</Color>
    <Color x:Key="PrimaryColor">#006c67</Color>
    <Color x:Key="OnPrimaryColor">#ffffff</Color>
    <Color x:Key="DangerColor">#a92e37</Color>
    <Color x:Key="ControlLineColor">#788d87</Color>
    <Color x:Key="WarningColor">#895900</Color>
    <Color x:Key="SelectionColor">#d8eeea</Color>
    <Color x:Key="ViewportColor">#17272c</Color>
    <Color x:Key="ViewportGridColor">#344b50</Color>
    <Color x:Key="ViewportInkColor">#edf4f2</Color>
    <Color x:Key="FoilColor">#85c9c4</Color>
    <Color x:Key="StationColor">#66ddc8</Color>
    <Color x:Key="FocusRingViewportColor">#66ddc8</Color>
    <Color x:Key="ViewportMuteColor">#afc6c7</Color>
    <Color x:Key="DangerViewportColor">#ffaeb5</Color>
    <Color x:Key="WarningViewportColor">#efc576</Color>
    <Color x:Key="ViewportSoftColor">#243a40</Color>
    <!-- DESIGN.md colors.foil-shade-lit: the lit end of the shaded-surface ramp from viewport-soft, capped so overlays keep 3:1. -->
    <Color x:Key="FoilShadeLitColor">#3f6a6c</Color>
    <!-- DESIGN.md colors.foil-edge: authored sections on the shaded surface; high contrast uses contrast-ink (HighContrastInkColor). -->
    <Color x:Key="FoilEdgeColor">#c4e7df</Color>
    <Thickness x:Key="Space2">8</Thickness>
    <Thickness x:Key="Space3">12</Thickness>
    <Thickness x:Key="Space4">16</Thickness>
    <Thickness x:Key="Space6">24</Thickness>
    <x:Double x:Key="TitleSize">24</x:Double>
    <x:Double x:Key="HeadingSize">18</x:Double>
    <x:Double x:Key="BodySize">14</x:Double>
    <x:Double x:Key="CaptionSize">12</x:Double>
    <x:Double x:Key="ControlHeight">32</x:Double>
    <!-- Property sheet, structure B (DESIGN.md §12.0f; docs/reviews/ui-property-grid-cells.md §5.1). The pane writes a
         scaled copy (base × PropTextScale, DN-5) of every size token marked "scales" into its own resources. -->
    <!-- typography.prop: tabular figures need a face that has them. The default (Helvetica) has proportional digits and
         ignores tnum; the macOS system face honours tnum but renders heavy at 11 px through Skia, and a fallback list does
         not resolve it. Helvetica Neue (macOS) has tabular digits; Segoe UI (Windows) honours tnum. -->
    <OnPlatform x:Key="PropFontFamily" x:TypeArguments="FontFamily" Default="Segoe UI" macOS="Helvetica Neue" />
    <x:Double x:Key="PropTextScale">1</x:Double>
    <x:Double x:Key="PropFontSize">11</x:Double>            <!-- scales: typography.prop -->
    <x:Double x:Key="PropLineHeight">14</x:Double>          <!-- scales -->
    <x:Double x:Key="PropNoteSize">11</x:Double>            <!-- scales: typography.prop-note -->
    <x:Double x:Key="PropNoteLineHeight">14</x:Double>      <!-- scales -->
    <x:Double x:Key="PropTitleSize">13</x:Double>           <!-- scales: typography.prop-title -->
    <x:Double x:Key="PropTitleLineHeight">18</x:Double>     <!-- scales -->
    <x:Double x:Key="PropHeadHeight">24</x:Double>          <!-- scales: spacing.prop-head -->
    <x:Double x:Key="PropRowReadOnlyHeight">20</x:Double>   <!-- scales: spacing.prop-row-ro -->
    <x:Double x:Key="PropRowInputHeight">24</x:Double>      <!-- scales: spacing.prop-row-input -->
    <x:Double x:Key="PropEditBoxHeight">20</x:Double>       <!-- scales: spacing.prop-edit-box (the focus box only) -->
    <x:Double x:Key="PropValueMinWidth">62</x:Double>       <!-- scales: spacing.prop-value -->
    <x:Double x:Key="PropUnitWidth">24</x:Double>           <!-- scales: spacing.prop-unit -->
    <x:Double x:Key="PropIndent">22</x:Double>              <!-- spacing.prop-indent, rail included -->
    <x:Double x:Key="PropIndentSub">32</x:Double>           <!-- spacing.prop-indent-sub -->
    <x:Double x:Key="PropInset">8</x:Double>                <!-- spacing.prop-inset -->
    <x:Double x:Key="PropColumnGap">3</x:Double>            <!-- B's column gap between label, value and unit -->
    <Thickness x:Key="PropFactDigitInset">0,0,5,0</Thickness>   <!-- DC-3: a fact's digits end where an input's do (band 2 + padding 3) -->
    <Thickness x:Key="PropRowPadding">19,0,8,0</Thickness>      <!-- + the 3 px rail = spacing.prop-indent -->
    <Thickness x:Key="PropRowPaddingSub">29,0,8,0</Thickness>   <!-- + the 3 px rail = spacing.prop-indent-sub -->
    <Thickness x:Key="PropLineBelow">0,0,0,3</Thickness>
    <x:Double x:Key="PropLockSize">10</x:Double>
    <x:Double x:Key="PropIconSize">11</x:Double>
    <Thickness x:Key="PropIconGap">0,1.5,4,0</Thickness>
    <Thickness x:Key="PropLockGap">0,0,3,0</Thickness>
    <Thickness x:Key="PropEditBandThickness">2</Thickness>   <!-- the transparent band around the 20 px box -->
    <Thickness x:Key="PropEditPadding">3,3</Thickness>       <!-- scales (vertical): 2 + 3 + 14 + 3 + 2 = the 24 px band -->
    <x:Double x:Key="PropCueOffset">2</x:Double>            <!-- the dotted underline sits 2 px below the baseline -->
    <x:Double x:Key="PropGlyphSize">12</x:Double>
    <x:Double x:Key="PropChevronSize">10</x:Double>
    <x:Double x:Key="PropEnumGlyphWidth">5</x:Double>
    <x:Double x:Key="PropEnumGlyphHeight">3</x:Double>
    <x:Double x:Key="PropChevronGap">6</x:Double>
    <Thickness x:Key="PropWingRuleMargin">15,6,12,0</Thickness>
    <Thickness x:Key="PropHeadPadding">8,0</Thickness>
    <Thickness x:Key="PropIdentityPadding">8,6</Thickness>
    <Thickness x:Key="PropNotePadding">22,0,8,3</Thickness>
    <Thickness x:Key="PropSubheadPadding">22,4,8,0</Thickness>
    <Thickness x:Key="PropLinkPadding">22,0,8,0</Thickness>
    <Thickness x:Key="PropRuleTop">0,1,0,0</Thickness>
    <Thickness x:Key="PropRuleBottom">0,0,0,1</Thickness>
    <Thickness x:Key="PropTitleGap">6,0,0,0</Thickness>
    <Thickness x:Key="PropEnumGlyphMargin">4,0,2,0</Thickness>
    <Thickness x:Key="PropEnumPadding">2,0,0,0</Thickness>
    <Thickness x:Key="PropErrorRingInset">1</Thickness>
    <x:Double x:Key="StackGap1">4</x:Double>
    <x:Double x:Key="StackGap2">8</x:Double>
    <x:Double x:Key="StackGap3">12</x:Double>
    <Thickness x:Key="Space1">4</Thickness>
    <Thickness x:Key="PropRailThickness">3,0,0,0</Thickness>
    <Thickness x:Key="FocusRingThickness">2</Thickness>
    <Thickness x:Key="FocusRingInset">0</Thickness>
    <Thickness x:Key="ChipPadding">6,0</Thickness>
    <Thickness x:Key="HairlineThickness">1</Thickness>
    <Thickness x:Key="HairlineTop">0,1,0,0</Thickness>
    <Thickness x:Key="NoInset">0</Thickness>
    <Thickness x:Key="UnitGap">4,0,0,0</Thickness>
    <Thickness x:Key="GlyphGap">0,0,8,0</Thickness>
    <x:Double x:Key="HairlineHeight">1</x:Double>
    <x:Double x:Key="GlyphStroke">1.5</x:Double>
    <x:Double x:Key="StationListHeight">120</x:Double>
    <x:Double x:Key="NavigatorListHeight">180</x:Double>
    <x:Double x:Key="SectionViewportHeight">96</x:Double>
    <x:Double x:Key="SectionThumbnailWidth">200</x:Double>
    <x:Double x:Key="SectionThumbnailHeight">80</x:Double>
    <x:Double x:Key="SectionEditorMinHeight">160</x:Double>
    <GridLength x:Key="SectionPanelHeight">300</GridLength>
    <x:Double x:Key="ViewportAnnotationWidth">178</x:Double>
    <x:Double x:Key="ViewportAnnotationHeight">160</x:Double>
    <x:Double x:Key="SectionAnnotationHeight">72</x:Double>
    <x:Double x:Key="WindowWidth">1280</x:Double>
    <x:Double x:Key="WindowHeight">800</x:Double>
    <x:Double x:Key="WindowMinWidth">1024</x:Double>
    <x:Double x:Key="WindowMinHeight">700</x:Double>
    <!-- Status strip and warning toast (DR-STATUS-1; DESIGN.md §4 Status strip, Toast; docs/reviews/ui-status-bar.md §2.2). -->
    <x:Double x:Key="ShellStatusbarHeight">24</x:Double>      <!-- spacing.shell-statusbar -->
    <x:Double x:Key="CompactTargetSize">24</x:Double>         <!-- the 24 × 24 px minimum target (SC 2.5.8) -->
    <x:Double x:Key="StatusIconSize">12</x:Double>
    <x:Double x:Key="ToastIconSize">14</x:Double>
    <x:Double x:Key="ToastWidth">420</x:Double>               <!-- spacing.toast-w -->
    <x:Double x:Key="ToastHoldMilliseconds">8000</x:Double>   <!-- motion.toast-hold -->
    <x:Double x:Key="RailWidth">3</x:Double>                  <!-- the 3 px warning / error rail -->
    <Thickness x:Key="ToastInset">12</Thickness>              <!-- spacing.toast-inset -->
    <Thickness x:Key="ToastPadding">10,8</Thickness>
    <Thickness x:Key="HairlineLeft">1,0,0,0</Thickness>
    <Thickness x:Key="ToastBorder">0,1,1,1</Thickness>        <!-- the left edge is the rail -->
    <Thickness x:Key="StatusMessagePadding">10,0</Thickness>
    <Thickness x:Key="StatusItemPadding">8,0</Thickness>
    <Thickness x:Key="StatusIconGap">0,0,6,0</Thickness>
    <Thickness x:Key="StatusActionGap">6,0,0,0</Thickness>
    <Thickness x:Key="ToastTextGap">8,0</Thickness>
    <CornerRadius x:Key="RoundedSm">4</CornerRadius>          <!-- rounded.sm -->
    <BoxShadows x:Key="PopoverShadow">0 8 24 0 #29000000</BoxShadows>   <!-- elevation.popover: 0 8px 24px rgba(0,0,0,0.16) -->
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontSize" Value="{StaticResource BodySize}" /></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="{StaticResource ControlHeight}" /><Setter Property="Padding" Value="{StaticResource Space3}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /></Style>
  <Style Selector="TabItem"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /></Style>
  <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource InkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource CanvasBrush}" /></Style>
  <Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource OnPrimaryBrush}" /></Style>
  <Style Selector="TabItem:pressed /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource OnPrimaryBrush}" /></Style>
  <Style Selector="TabItem:selected:pressed /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource InkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource CanvasBrush}" /></Style>
  <!-- Dock's tool chrome repeats the active tool's title in its header (ToolChromeControl.axaml:169, PART_Title) above the
       tab row that already names it. The tab row is the one label; the header keeps only its pane-menu and close buttons. -->
  <Style Selector="dock|ToolChromeControl /template/ TextBlock#PART_Title"><Setter Property="IsVisible" Value="False" /></Style>
  <!-- Dock tabs are TabStripItems, not TabItems. Dock styles them in ControlThemes, which any Style outranks, but its
       selected, hover and active states share brush keys, so the selected fill is set here per control type. -->
  <!-- NS-1: a tab row is one Tab stop and the arrow keys move along it (a tab list), so Tab from the Plan reaches the pane
       below the row instead of walking every tab first. -->
  <Style Selector="dock|DocumentTabStrip, dock|ToolTabStrip"><Setter Property="KeyboardNavigation.TabNavigation" Value="Once" /></Style>
  <Style Selector="dock|DocumentTabStripItem:selected, dock|ToolTabStripItem:selected"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /></Style>
  <!-- A Primary selected fill hides Fluent's inner focus tone (Ink), so these selectable items use OnPrimary inside the
       Primary ring. Set for every state: Avalonia builds the adorner at focus time, and selection can follow focus. -->
  <Style Selector="dock|DocumentTabStripItem, dock|ToolTabStripItem, ListBoxItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="{DynamicResource SystemControlFocusVisualPrimaryThickness}" BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}" Margin="{DynamicResource SystemControlFocusVisualMargin}">
          <Border BorderThickness="{DynamicResource SystemControlFocusVisualSecondaryThickness}" BorderBrush="{DynamicResource OnPrimaryBrush}" />
        </Border>
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /></Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource InkBrush}" /><Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" /></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="{StaticResource ControlHeight}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" /><Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnPrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /></Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="TextBox:focus:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="TextBox /template/ TextPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="TextBox:pointerover /template/ TextPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ListBox"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
  <Style Selector="ListBoxItem:selected"><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ListBoxItem:selected:not(:focus) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" /><Setter Property="Background" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /></Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" /><Setter Property="Background" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Button:focus-visible, TabItem:focus-visible, TextBox:focus-visible, ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="{StaticResource HeadingSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="{StaticResource CaptionSize}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <!-- Property sheet, structure B (DR-CELL-1; docs/reviews/ui-property-grid-cells.md §5.2). Every brush is a theme resource
       defined in Light, Dark and High contrast, so each state below resolves in all three variants (PG-11). Every size
       reads a DynamicResource: the pane overrides the scaled copies for the Text size setting (DN-5). -->
  <Style Selector="Border.prop-rule"><Setter Property="Height" Value="{StaticResource HairlineHeight}" /><Setter Property="Background" Value="{DynamicResource LineBrush}" /><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="Border.prop-row"><Setter Property="BorderThickness" Value="{StaticResource PropRailThickness}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="{StaticResource PropRowPadding}" /></Style>
  <Style Selector="Border.prop-row.sub"><Setter Property="Padding" Value="{StaticResource PropRowPaddingSub}" /></Style>
  <Style Selector="Border.prop-row.warning"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.prop-row.unavailable"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.prop-row.error"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="TextBlock.prop-label"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextTrimming" Value="None" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="TextBlock.prop-value"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Padding" Value="{StaticResource PropFactDigitInset}" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>
  <Style Selector="StackPanel.prop-value-cell"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Path.prop-lock"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /><Setter Property="Width" Value="{StaticResource PropLockSize}" /><Setter Property="Height" Value="{StaticResource PropLockSize}" /><Setter Property="StrokeThickness" Value="{StaticResource HairlineHeight}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="{StaticResource PropLockGap}" /></Style>
  <Style Selector="TextBlock.prop-unit"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="TextBlock.prop-note"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropNoteLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Padding" Value="{StaticResource PropNotePadding}" /></Style>
  <Style Selector="TextBlock.prop-desc"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropNoteLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Padding" Value="{StaticResource PropLineBelow}" /></Style>
  <Style Selector="TextBlock.prop-note.warning, TextBlock.prop-message.warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="TextBlock.prop-message"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropNoteLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Padding" Value="{StaticResource PropLineBelow}" /></Style>
  <Style Selector="TextBlock.prop-message.error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="TextBlock.prop-subhead"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Padding" Value="{StaticResource PropSubheadPadding}" /></Style>
  <Style Selector="TextBlock.prop-group-title"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="TextBlock.prop-summary"><Setter Property="Margin" Value="{StaticResource PropTitleGap}" /><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropNoteLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>
  <Style Selector="TextBlock.prop-title"><Setter Property="FontSize" Value="{DynamicResource PropTitleSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropTitleLineHeight}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="TextBlock.prop-crumb"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="HyperlinkButton.prop-crumb"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="MinHeight" Value="{DynamicResource PropRowInputHeight}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Path.prop-chevron"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /><Setter Property="Width" Value="{StaticResource PropChevronSize}" /><Setter Property="Height" Value="{StaticResource PropChevronSize}" /><Setter Property="StrokeThickness" Value="{StaticResource GlyphStroke}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="StackPanel.prop-body"><Setter Property="Spacing" Value="0" /></Style>
  <Style Selector="Path.prop-icon"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /><Setter Property="Width" Value="{StaticResource PropIconSize}" /><Setter Property="Height" Value="{StaticResource PropIconSize}" /><Setter Property="StrokeThickness" Value="{StaticResource HairlineHeight}" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="Margin" Value="{StaticResource PropIconGap}" /></Style>
  <Style Selector="Path.prop-icon.error"><Setter Property="Stroke" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Path.prop-icon.warning"><Setter Property="Stroke" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Path.prop-disclosure"><Setter Property="Fill" Value="{DynamicResource MutedBrush}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Path.filled"><Setter Property="Fill" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Border.prop-chip"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="Padding" Value="{StaticResource ChipPadding}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Border.prop-chip TextBlock"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>

  <!-- The editable value (one element, DN-2): accent text with a dotted underline at rest (the pane draws the line in the
       template, CL-3 option A); a 20 px box with a 1 px accent boundary inside the 24 px band on focus, text in ink. -->
  <Style Selector="TextBox.prop-b"><Setter Property="MinHeight" Value="0" /><Setter Property="FontFamily" Value="{StaticResource PropFontFamily}" /><Setter Property="MinWidth" Value="{DynamicResource PropValueMinWidth}" /><Setter Property="Width" Value="{DynamicResource PropValueMinWidth}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Padding" Value="{DynamicResource PropEditPadding}" /><Setter Property="BorderThickness" Value="{StaticResource PropEditBandThickness}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>
  <Style Selector="TextBox.prop-b.dirty"><Setter Property="Width" Value="NaN" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="TextBox.prop-b /template/ Border#PART_BorderElement"><Setter Property="Margin" Value="{StaticResource PropEditBandThickness}" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="TextBox.prop-b:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="TextBox.prop-b:focus /template/ Border#PART_BorderElement, TextBox.prop-b:focus:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="TextBox.prop-b.error /template/ Border#PART_BorderElement, TextBox.prop-b.error:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="TextBox.prop-b.error:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="TextBox.prop-b /template/ TextPresenter, TextBox.prop-b:pointerover /template/ TextPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="TextBox.prop-b:focus /template/ TextPresenter, TextBox.prop-b.error /template/ TextPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="TextBox.prop-b:focus, TextBox.prop-b.error"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Border.prop-error-ring"><Setter Property="Margin" Value="{StaticResource PropErrorRingInset}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>

  <!-- The enum value (Type, Tangent kind): accent text + ▾ in muted ink, no box until focused, then the same box. -->
  <Style Selector="ComboBox.prop-b"><Setter Property="MinHeight" Value="{DynamicResource PropRowInputHeight}" /><Setter Property="FontFamily" Value="{StaticResource PropFontFamily}" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="{StaticResource PropEnumPadding}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Right" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /></Style>
  <Style Selector="ComboBox.prop-b /template/ Border#Background, ComboBox.prop-b:pointerover /template/ Border#Background, ComboBox.prop-b:pressed /template/ Border#Background"><Setter Property="Margin" Value="{StaticResource PropEditBandThickness}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="ComboBox.prop-b:focus /template/ Border#Background, ComboBox.prop-b:dropdownopen /template/ Border#Background"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ComboBox.prop-b /template/ ContentControl#ContentPresenter, ComboBox.prop-b:pointerover /template/ ContentControl#ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ComboBox.prop-b:focus /template/ ContentControl#ContentPresenter, ComboBox.prop-b:dropdownopen /template/ ContentControl#ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ComboBox.prop-b /template/ PathIcon#DropDownGlyph"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Width" Value="{StaticResource PropEnumGlyphWidth}" /><Setter Property="Height" Value="{StaticResource PropEnumGlyphHeight}" /><Setter Property="Margin" Value="{StaticResource PropEnumGlyphMargin}" /><Setter Property="Data" Value="M0,0 L5,0 L2.5,3 Z" /></Style>
  <Style Selector="ComboBox.prop-b /template/ Border#PopupBorder"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlLineBrush}" /></Style>
  <Style Selector="ComboBox.prop-b ComboBoxItem"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /></Style>
  <Style Selector="ComboBox.prop-b ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ComboBox.prop-b ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBox.prop-b ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ComboBox.prop-b ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBox.prop-b ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBox.prop-b ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnSelectionBrush}" /></Style>

  <!-- The twirl group header: 24 px, no band, a 10 px chevron at the left in muted ink (the pane draws it; Fluent's is hidden). -->
  <Style Selector="Expander.prop-group"><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="MinHeight" Value="{DynamicResource PropHeadHeight}" /></Style>
  <Style Selector="Expander.prop-group /template/ Border#ExpanderContent"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Expander.prop-group /template/ ToggleButton#ExpanderHeader"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="MinHeight" Value="{DynamicResource PropHeadHeight}" /><Setter Property="Padding" Value="{StaticResource PropHeadPadding}" /></Style>
  <Style Selector="Expander.prop-group /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground, Expander.prop-group /template/ ToggleButton#ExpanderHeader:checked /template/ Border#ToggleButtonBackground, Expander.prop-group /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground, Expander.prop-group /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Expander.prop-group /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter, Expander.prop-group /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Margin" Value="{StaticResource PropHeadPadding}" /></Style>
  <Style Selector="Expander.prop-group /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder"><Setter Property="IsVisible" Value="False" /></Style>

  <!-- DR-CELL-5: a link takes a solid underline; the dotted one means an editable value. -->
  <Style Selector="ToggleButton.prop-link"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="{StaticResource PropLinkPadding}" /><Setter Property="MinHeight" Value="{DynamicResource PropHeadHeight}" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ToggleButton.prop-link /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-link:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-link:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-link:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-link:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ToggleButton.prop-link TextBlock"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropNoteLineHeight}" /><Setter Property="TextDecorations" Value="Underline" /></Style>

  <Style Selector="Expander.prop-group ToggleButton, ToggleButton.prop-link, HyperlinkButton.prop-crumb">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="{StaticResource FocusRingThickness}" BorderBrush="{DynamicResource FocusRingBrush}" Margin="{StaticResource FocusRingInset}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="TextBox.prop-b, ComboBox.prop-b"><Setter Property="FocusAdorner" Value="{x:Null}" /></Style>

  <!-- Status strip (DESIGN.md §4): the last report, one line, an icon and text coloured by kind and, for a warning or an
       error, a 3 px rail at the left edge; read-only items on the right split by hairlines. Sizes read the prop tokens,
       which the strip scales for Text size (DN-5). -->
  <Style Selector="Border.status-strip"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="MinHeight" Value="{StaticResource ShellStatusbarHeight}" /></Style>
  <Style Selector="Border.status-rule"><Setter Property="Height" Value="{StaticResource HairlineHeight}" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="Background" Value="{DynamicResource LineBrush}" /></Style>
  <Style Selector="Border.status-strip TextBlock"><Setter Property="FontFamily" Value="{StaticResource PropFontFamily}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Border.status-strip TextBlock.status-text.warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.status-strip TextBlock.status-text.error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.status-strip Border.status-item TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Border.status-rail"><Setter Property="Width" Value="{StaticResource RailWidth}" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Border.status-rail.warning, Border.toast-rail"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.status-rail.error"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.status-item"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineLeft}" /><Setter Property="Padding" Value="{StaticResource StatusItemPadding}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /></Style>
  <Style Selector="Path.status-icon"><Setter Property="Stroke" Value="{DynamicResource InkBrush}" /><Setter Property="StrokeThickness" Value="1.3" /><Setter Property="Width" Value="{StaticResource StatusIconSize}" /><Setter Property="Height" Value="{StaticResource StatusIconSize}" /><Setter Property="Stretch" Value="None" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Path.status-icon.warning"><Setter Property="Stroke" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Path.status-icon.error"><Setter Property="Stroke" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Path.status-icon.toast-icon"><Setter Property="Width" Value="{StaticResource ToastIconSize}" /><Setter Property="Height" Value="{StaticResource ToastIconSize}" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
  <Style Selector="Button.status-action"><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="MinWidth" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource StatusItemPadding}" /><Setter Property="Margin" Value="{StaticResource StatusActionGap}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /></Style>

  <!-- Warning toast (DESIGN.md §4 Toast): one card at the model area's bottom-right; surface, a 1 px control-line border, a
       3 px warning rail, rounded.sm and elevation.popover. No motion: it appears and disappears at once (PG-16). -->
  <Style Selector="Border.toast"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlLineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource ToastBorder}" /><Setter Property="CornerRadius" Value="{StaticResource RoundedSm}" /><Setter Property="BoxShadow" Value="{StaticResource PopoverShadow}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Margin" Value="{StaticResource ToastInset}" /></Style>
  <Style Selector="Border.toast TextBlock"><Setter Property="FontFamily" Value="{StaticResource PropFontFamily}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button.toast-dismiss"><Setter Property="Width" Value="{StaticResource CompactTargetSize}" /><Setter Property="Height" Value="{StaticResource CompactTargetSize}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
</Styles>
