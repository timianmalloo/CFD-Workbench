  <Style Selector="TextBox.prop-b:focus /template/ TextPresenter, TextBox.prop-b.error /template/ TextPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="TextBox.prop-b:focus, TextBox.prop-b.error"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Border.prop-error-ring"><Setter Property="Margin" Value="{StaticResource PropErrorRingInset}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>

  <!-- The enum value (Type, Tangent kind): accent text + ▾ in muted ink, no box until focused, then the same box. -->
  <Style Selector="ComboBox.prop-b"><Setter Property="MinHeight" Value="{DynamicResource PropRowInputHeight}" /><Setter Property="FontFamily" Value="{StaticResource PropFontFamily}" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="{StaticResource PropEnumPadding}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Right" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /></Style>
  <Style Selector="ComboBox.prop-b /template/ Border#Background, ComboBox.prop-b:pointerover /template/ Border#Background, ComboBox.prop-b:pressed /template/ Border#Background"><Setter Property="Margin" Value="{StaticResource PropEditBandThickness}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="ComboBox.prop-b:focus /template/ Border#Background, ComboBox.prop-b:dropdownopen /template/ Border#Background"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ComboBox.prop-b /template/ ContentControl#ContentPresenter, ComboBox.prop-b:pointerover /template/ ContentControl#ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ComboBox.prop-b:focus /template/ ContentControl#ContentPresenter, ComboBox.prop-b:dropdownopen /template/ ContentControl#ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ComboBox.prop-b /template/ PathIcon#DropDownGlyph"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Width" Value="{StaticResource PropEnumGlyphWidth}" /><Setter Property="Height" Value="{StaticResource PropEnumGlyphHeight}" /><Setter Property="Margin" Value="{StaticResource PropEnumGlyphMargin}" /><Setter Property="Data" Value="M0,0 L5,0 L2.5,3 Z" /></Style>
  <Style Selector="ComboBox.prop-b /template/ Border#PopupBorder"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlLineBrush}" /></Style>
  <Style Selector="ComboBox.prop-b ComboBoxItem"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /></Style>
  <Style Selector="ComboBox.prop-b ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ComboBox.prop-b ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBox.prop-b ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ComboBox.prop-b ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBox.prop-b ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBox.prop-b ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnSelectionBrush}" /></Style>

  <!-- The twirl group header: 24 px, no band, a 10 px chevron at the left in muted ink (the pane draws it; Fluent's is hidden). -->
  <Style Selector="Expander.prop-group"><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="MinHeight" Value="{DynamicResource PropHeadHeight}" /></Style>
  <Style Selector="Expander.prop-group /template/ Border#ExpanderContent"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Expander.prop-group /template/ ToggleButton#ExpanderHeader"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="MinHeight" Value="{DynamicResource PropHeadHeight}" /><Setter Property="Padding" Value="{StaticResource PropHeadPadding}" /></Style>
  <Style Selector="Expander.prop-group /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground, Expander.prop-group /template/ ToggleButton#ExpanderHeader:checked /template/ Border#ToggleButtonBackground, Expander.prop-group /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground, Expander.prop-group /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#ToggleButtonBackground"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Expander.prop-group /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter, Expander.prop-group /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="Margin" Value="{StaticResource PropHeadPadding}" /></Style>
  <Style Selector="Expander.prop-group /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder"><Setter Property="IsVisible" Value="False" /></Style>

  <!-- DR-CELL-5: a link takes a solid underline; the dotted one means an editable value. -->
  <Style Selector="ToggleButton.prop-link"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="{StaticResource PropLinkPadding}" /><Setter Property="MinHeight" Value="{DynamicResource PropHeadHeight}" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ToggleButton.prop-link /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-link:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-link:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-link:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-link:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="ToggleButton.prop-link TextBlock"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropNoteLineHeight}" /><Setter Property="TextDecorations" Value="Underline" /></Style>

  <Style Selector="Expander.prop-group ToggleButton, ToggleButton.prop-link, HyperlinkButton.prop-crumb">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="{StaticResource FocusRingThickness}" BorderBrush="{DynamicResource FocusRingBrush}" Margin="{StaticResource FocusRingInset}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="TextBox.prop-b, ComboBox.prop-b"><Setter Property="FocusAdorner" Value="{x:Null}" /></Style>

  <!-- Status strip (DESIGN.md §4): the last report, one line, an icon and text coloured by kind and, for a warning or an
       error, a 3 px rail at the left edge; read-only items on the right split by hairlines. Sizes read the prop tokens,
       which the strip scales for Text size (DN-5). -->
  <Style Selector="Border.status-strip"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="MinHeight" Value="{StaticResource ShellStatusbarHeight}" /></Style>
  <Style Selector="Border.status-rule"><Setter Property="Height" Value="{StaticResource HairlineHeight}" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="Background" Value="{DynamicResource LineBrush}" /></Style>
  <Style Selector="Border.status-strip TextBlock"><Setter Property="FontFamily" Value="{StaticResource PropFontFamily}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Border.status-strip TextBlock.status-text.warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.status-strip TextBlock.status-text.error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.status-strip Border.status-item TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Border.status-rail"><Setter Property="Width" Value="{StaticResource RailWidth}" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Border.status-rail.warning, Border.toast-rail"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.status-rail.error"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.status-item"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineLeft}" /><Setter Property="Padding" Value="{StaticResource StatusItemPadding}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /></Style>
  <Style Selector="Path.status-icon"><Setter Property="Stroke" Value="{DynamicResource InkBrush}" /><Setter Property="StrokeThickness" Value="1.3" /><Setter Property="Width" Value="{StaticResource StatusIconSize}" /><Setter Property="Height" Value="{StaticResource StatusIconSize}" /><Setter Property="Stretch" Value="None" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="Path.status-icon.warning"><Setter Property="Stroke" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Path.status-icon.error"><Setter Property="Stroke" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Path.status-icon.toast-icon"><Setter Property="Width" Value="{StaticResource ToastIconSize}" /><Setter Property="Height" Value="{StaticResource ToastIconSize}" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
  <Style Selector="Button.status-action"><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="MinWidth" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource StatusItemPadding}" /><Setter Property="Margin" Value="{StaticResource StatusActionGap}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /></Style>

  <!-- Warning toast (DESIGN.md §4 Toast): one card at the model area's bottom-right; surface, a 1 px control-line border, a
       3 px warning rail, rounded.sm and elevation.popover. No motion: it appears and disappears at once (PG-16). -->
  <Style Selector="Border.toast"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlLineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource ToastBorder}" /><Setter Property="CornerRadius" Value="{StaticResource RoundedSm}" /><Setter Property="BoxShadow" Value="{StaticResource PopoverShadow}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Margin" Value="{StaticResource ToastInset}" /></Style>
  <Style Selector="Border.toast TextBlock"><Setter Property="FontFamily" Value="{StaticResource PropFontFamily}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button.toast-dismiss"><Setter Property="Width" Value="{StaticResource CompactTargetSize}" /><Setter Property="Height" Value="{StaticResource CompactTargetSize}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Top" /></Style>

  <!-- DR-VIEW-7 (v10 .vlabel, ≥ 24 × 24): each view's label is a small viewport-soft plate over the view's top-left, drawn
       above the view (ZIndex) and first in the view's Tab order; the target view's plate carries a station underline. -->
  <Style Selector="Button.viewLabel"><Setter Property="ZIndex" Value="1" /><Setter Property="Background" Value="{DynamicResource PlanSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource ViewportInkBrush}" /><Setter Property="BorderThickness" Value="{StaticResource NoInset}" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="Margin" Value="{StaticResource ViewPlateInset}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="MinWidth" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource ViewPlatePadding}" /><Setter Property="CornerRadius" Value="{StaticResource ViewPlateRadius}" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.viewLabel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style Selector="Button.viewLabel.target"><Setter Property="BorderBrush" Value="{DynamicResource PlanSelectionBrush}" /><Setter Property="BorderThickness" Value="{StaticResource ViewPlateTargetEdge}" /></Style>

  <!-- The model-area navbar (v10 navbar + M1.2b2's Display ▾ and Fit Selection): chrome-coloured, bottom centre. -->
  <Style Selector="Border.navbar"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="CornerRadius" Value="{StaticResource NavbarRadius}" /><Setter Property="Padding" Value="{StaticResource NavbarPadding}" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Bottom" /><Setter Property="Margin" Value="{StaticResource NavbarInset}" /></Style>
  <Style Selector="Border.navbar-separator"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineLeft}" /><Setter Property="Margin" Value="{StaticResource NavbarSeparatorMargin}" /></Style>
  <Style Selector="Button.navbar"><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="MinWidth" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource NavbarButtonPadding}" /><Setter Property="BorderThickness" Value="{StaticResource NoInset}" /><Setter Property="CornerRadius" Value="{StaticResource RoundedSm}" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="ToolTip.ShowOnDisabled" Value="True" /></Style>
  <Style Selector="Button.navbar:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Button.navbar:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="MenuFlyoutPresenter.navbar-menu"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlLineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="CornerRadius" Value="{StaticResource NavbarRadius}" /><Setter Property="Padding" Value="{StaticResource NavbarMenuPadding}" /><Setter Property="MinWidth" Value="{StaticResource NavbarMenuMinWidth}" /></Style>
  <Style Selector="MenuFlyoutPresenter.navbar-menu MenuItem"><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource NavbarMenuItemPadding}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="MenuFlyoutPresenter.navbar-menu MenuItem:checked"><Setter Property="FontWeight" Value="SemiBold" /></Style>

  <!-- The section editor's mode bar (M1.2c §11.1; mockup .modebar): 24 px buttons with 0 8px padding, a pressed toggle on
       the soft fill with a hairline (never Fluent's accent), Cancel outlined, Finish the one primary. -->
  <Style Selector="Border.modebar"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource PropRuleBottom}" /><Setter Property="Padding" Value="{StaticResource ModeBarInset}" /></Style>
  <Style Selector="TextBlock.modebar-title"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="{StaticResource ModeTitleSize}" /><Setter Property="Margin" Value="{StaticResource ModeBarTitleGap}" /></Style>
  <Style Selector="Border.modebar-chip"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Padding" Value="{StaticResource ScopeChipPadding}" /><Setter Property="CornerRadius" Value="{StaticResource ScopeChipRadius}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /></Style>
  <Style Selector="Border.modebar-chip TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /></Style>
  <Style Selector="Button.modebar-link"><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource NoInset}" /><Setter Property="BorderThickness" Value="{StaticResource NoInset}" /><Setter Property="Background" Value="Transparent" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.modebar-link TextBlock, Button.modebar-link:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="Button.modebar-link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.modebar-link:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.modebar, ToggleButton.modebar"><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource ModeBarButtonPadding}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="CornerRadius" Value="{StaticResource RoundedSm}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.modebar:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.modebar:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="ToggleButton.modebar:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.modebar:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.modebar:checked:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.modebar:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Button.modebar.outline"><Setter Property="BorderBrush" Value="{DynamicResource ControlLineBrush}" /></Style>
  <Style Selector="Button.modebar.primary"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.modebar.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" /></Style>
  <Style Selector="Button.modebar.primary:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <!-- The mode canvas's plates (mockup .plate, .vlabel.on, .why, .lb): viewport-soft plates with viewport-ink text. -->
  <Style Selector="Border.modeplate"><Setter Property="Background" Value="{DynamicResource PlanSoftBrush}" /><Setter Property="CornerRadius" Value="{StaticResource ViewPlateRadius}" /><Setter Property="Padding" Value="{StaticResource ModePlatePadding}" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
  <Style Selector="Border.modeplate.target"><Setter Property="BorderBrush" Value="{DynamicResource PlanSelectionBrush}" /><Setter Property="BorderThickness" Value="{StaticResource ViewPlateTargetEdge}" /></Style>
  <Style Selector="TextBlock.modeplate"><Setter Property="Foreground" Value="{DynamicResource ViewportInkBrush}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /></Style>
  <Style Selector="Border.modereason"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="MaxWidth" Value="{StaticResource ModeReasonMaxWidth}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /><Setter Property="BorderThickness" Value="{StaticResource ModeReasonBorder}" /><Setter Property="CornerRadius" Value="{StaticResource ViewPlateRadius}" /><Setter Property="Padding" Value="{StaticResource ModeReasonPadding}" /></Style>
  <Style Selector="Border.modereason TextBlock"><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /></Style>
  <!-- The station strip (mockup .strip, .thumb): a drawn section outline over two label rows; the current one underlined. -->
  <Style Selector="ScrollViewer.station-strip"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
  <Style Selector="Button.station-thumb"><Setter Property="Width" Value="{StaticResource StationThumbWidth}" /><Setter Property="MinHeight" Value="{StaticResource CompactTargetSize}" /><Setter Property="Padding" Value="{StaticResource NoInset}" /><Setter Property="Background" Value="{DynamicResource ViewportBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="CornerRadius" Value="{StaticResource ViewPlateRadius}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /></Style>
  <Style Selector="Button.station-thumb.current"><Setter Property="BorderBrush" Value="{DynamicResource StationBrush}" /><Setter Property="BorderThickness" Value="{StaticResource StationThumbCurrentEdge}" /></Style>
  <Style Selector="Button.station-thumb:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.station-thumb:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ViewportBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  <Style Selector="Border.station-thumb-label"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Padding" Value="{StaticResource StationThumbLabelPadding}" /></Style>
  <Style Selector="Border.station-thumb-label TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>
  <Style Selector="Border.station-thumb-label TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
</Styles>
