  <Style Selector="Border.prop-chip TextBlock"><Setter Property="FontSize" Value="{DynamicResource PropNoteSize}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>

  <!-- The editable value (one element, DN-2): accent text with a dotted underline at rest (the pane draws the line in the
       template, CL-3 option A); a 20 px box with a 1 px accent boundary inside the 24 px band on focus, text in ink. -->
  <Style Selector="TextBox.prop-b"><Setter Property="MinHeight" Value="{DynamicResource PropRowInputHeight}" /><Setter Property="FontFamily" Value="{StaticResource PropFontFamily}" /><Setter Property="MinWidth" Value="{DynamicResource PropValueMinWidth}" /><Setter Property="Width" Value="{DynamicResource PropValueMinWidth}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Padding" Value="{DynamicResource PropEditPadding}" /><Setter Property="BorderThickness" Value="{StaticResource PropEditBandThickness}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="LineHeight" Value="{DynamicResource PropLineHeight}" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="FontFeatures" Value="+tnum,+lnum" /></Style>
  <Style Selector="TextBox.prop-b.dirty"><Setter Property="Width" Value="NaN" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <!-- The group value row's inline Set to | Move by switch (mockup .seg): row height, a thin outline, the active side lightly filled. -->
  <Style Selector="Border.prop-seg-box"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="CornerRadius" Value="{StaticResource RoundedSm}" /><Setter Property="ClipToBounds" Value="True" /></Style>
  <Style Selector="ToggleButton.prop-seg"><Setter Property="MinHeight" Value="{DynamicResource PropRowInputHeight}" /><Setter Property="Height" Value="{DynamicResource PropRowInputHeight}" /><Setter Property="Padding" Value="8,0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontSize" Value="{DynamicResource PropFontSize}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="ToggleButton.prop-seg /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-seg:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-seg:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="ToggleButton.prop-seg:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /></Style>
  <Style Selector="ToggleButton.prop-seg:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.prop-seg:checked:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBox.prop-b /template/ Border#PART_BorderElement"><Setter Property="Margin" Value="{StaticResource PropEditBandThickness}" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="BorderThickness" Value="{StaticResource HairlineThickness}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="TextBox.prop-b:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="TextBox.prop-b:focus /template/ Border#PART_BorderElement, TextBox.prop-b:focus:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
  <Style Selector="TextBox.prop-b.error /template/ Border#PART_BorderElement, TextBox.prop-b.error:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="TextBox.prop-b.error:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
