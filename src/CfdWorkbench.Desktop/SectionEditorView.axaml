<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CfdWorkbench.Desktop"
             x:Class="CfdWorkbench.Desktop.SectionEditorView">
  <Grid>
  <!-- The mode surface as the approved mockup draws it (docs/mockups/m12c-section-editor.html .modebar, .chip, .plate,
       .why, .lb, .navbar.sec, .strip, .thumb; Rulings 60, 61): every size and colour is a Styles.axaml token. -->
  <Grid x:Name="ModeEditor" RowDefinitions="32,*,84" IsVisible="False">
    <Border Grid.Row="0" Classes="modebar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource ModeBarGap}">
        <TextBlock x:Name="ModeTitle" Grid.Column="0" Classes="modebar-title" />
        <Border x:Name="ScopeChipBorder" Grid.Column="1" Classes="modebar-chip" HorizontalAlignment="Left">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ScopeChip" Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="ScopeChipLink" Grid.Column="1" Classes="modebar-link" AutomationProperties.Name="Make this section unique to the station">
              <TextBlock x:Name="ScopeChipLinkText" TextDecorations="Underline" />
            </Button>
          </Grid>
        </Border>
        <Button x:Name="ModeSectionButton" Grid.Column="2" Classes="modebar" Content="Section ▾" AutomationProperties.Name="Section actions" />
        <ToggleButton x:Name="CurvatureToggle" Grid.Column="3" Classes="modebar" Content="Curvature" IsChecked="True" AutomationProperties.Name="Curvature comb" />
        <ToggleButton x:Name="ThicknessToggle" Grid.Column="4" Classes="modebar" Content="Thickness ×2" AutomationProperties.Name="Thickness drawn times two" />
        <Button x:Name="ModeCancelButton" Grid.Column="5" Classes="modebar outline" Content="Cancel" AutomationProperties.Name="Cancel section" />
        <Button x:Name="ModeFinishButton" Grid.Column="6" Classes="modebar primary" Content="Finish section" AutomationProperties.Name="Finish section" />
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <local:SectionCanvas x:Name="ModeCanvas" BackgroundBrush="{DynamicResource ViewportBrush}"
                           FoilBrush="{DynamicResource FoilBrush}" StationBrush="{DynamicResource StationBrush}"
                           FocusBrush="{DynamicResource PrimaryBrush}" DangerBrush="{DynamicResource PlanDangerBrush}"
                           AutomationProperties.Name="Section profile editor" />
      <!-- Top-left plates stacked cleanly so ModePlate never obscures ModeSourceChip (F-05); reason and probe at right. -->
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Top" Margin="{StaticResource ViewPlateInset}">
        <StackPanel Grid.Column="0" Spacing="{StaticResource StackGap1}" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Border Classes="modeplate target" HorizontalAlignment="Left" IsHitTestVisible="False">
            <TextBlock x:Name="ModePlate" Classes="modeplate" FontWeight="SemiBold" />
          </Border>
          <Border x:Name="ModeSourceChip" HorizontalAlignment="Left"
                  Padding="{StaticResource Space2}" CornerRadius="{StaticResource ViewPlateRadius}"
                  Background="{DynamicResource PlanSoftBrush}" BorderBrush="{DynamicResource PlanMuteBrush}" BorderThickness="1"
                  IsHitTestVisible="False">
            <TextBlock x:Name="ModeSourceChipText" Foreground="{DynamicResource ViewportInkBrush}" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="{StaticResource NavbarGap}" Margin="{StaticResource ModePlateGap}">
          <Border x:Name="ModeReasonBox" Classes="modereason" IsVisible="False">
            <TextBlock x:Name="ModeReason" TextWrapping="Wrap" Focusable="True" Foreground="{DynamicResource DangerBrush}"
                       AutomationProperties.LiveSetting="Assertive" />
          </Border>
          <Border Classes="modeplate" HorizontalAlignment="Right" IsHitTestVisible="False">
            <TextBlock x:Name="ModeProbe" Classes="modeplate" Text="Pointer · display" TextTrimming="CharacterEllipsis" />
          </Border>
        </StackPanel>
      </Grid>
      <Border x:Name="ModeCombPlate" Classes="modeplate" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{StaticResource ViewPlateInset}" IsHitTestVisible="False">
        <TextBlock x:Name="ModeCombLabel" Classes="modeplate" />
      </Border>
      <Border Classes="navbar">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource NavbarGap}">
          <Button x:Name="ModeFitButton" Classes="navbar" Content="Fit" />
          <Button x:Name="ModeFitSelectionButton" Classes="navbar" Content="Fit Selection" />
        </StackPanel>
      </Border>
    </Grid>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Classes="station-strip">
      <StackPanel x:Name="StationStrip" Orientation="Horizontal" Spacing="{StaticResource StationStripGap}" Margin="{StaticResource StationStripInset}" />
    </ScrollViewer>
  </Grid>
  </Grid>
</UserControl>
