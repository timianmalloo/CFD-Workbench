<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CfdWorkbench.Desktop.SaveSectionDialog" Title="Save to My sections"
        Width="{StaticResource ToastWidth}" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}">
  <Border Padding="{StaticResource Space3}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="{StaticResource HairlineThickness}">
    <StackPanel Spacing="8">
      <TextBlock Classes="heading" Text="Save to My sections" />
      <TextBlock Text="Name" />
      <TextBox x:Name="NameBox" AutomationProperties.Name="Section name" />
      <TextBlock x:Name="ProvenanceLine" TextWrapping="Wrap" />
      <TextBlock x:Name="RightsLine" TextWrapping="Wrap" />
      <TextBlock x:Name="SaveError" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                 IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
      <TextBlock x:Name="SavedRegion" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" />
        <Button x:Name="SaveButton" Content="Save" Classes="primary" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
